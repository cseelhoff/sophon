# Sophon settings for steps 1 and 2 (run on your laptop).
#
# Optional: copy this file to `.env` in the project folder to pre-fill settings:
#     install -m 600 .env.example .env   (PowerShell: Copy-Item .env.example .env)
# sophon-build-isos.sh / sophon-provision.sh (and .ps1) read `.env` automatically. Anything you leave out is asked for
# interactively, and at the end of `sophon-build-isos.sh` Sophon offers to save your decisions to `.env` (mode 0600).
#
# Rules: one NAME=value per line, no spaces around "=", no "export", optional quotes around the value, and
# lines starting with # are comments. A variable already set in your shell wins over this file. Only SOPHON_*
# variables are read. `.env` is git-ignored and never enters the reusable OS/app ISOs.
#
# Leave passwords blank if you prefer to be prompted interactively (answer `n` at the end-of-build `.env` save prompt
# if you do not want secrets persisted to `.env`). Keep `.env` mode 0600 whenever secrets are stored in it.

# --- Where InfraVM runs --------------------------------------------------------------------------------------
# proxmox | vcenter | hyperv. Leave blank to be asked from a menu (which also offers "only download and build").
# For Hyper-V on THIS Windows PC (run as the signed-in user, no password) use hyperv and leave SOPHON_HYPERV_HOST blank.
SOPHON_HYPERVISOR=

# --- Proxmox -------------------------------------------------------------------------------------------------
# API host name or address (port below).
SOPHON_PROXMOX_HOST=
# API port.
SOPHON_PROXMOX_PORT=8006
# The real node name shown in the Proxmox tree (usually not "proxmox").
SOPHON_PROXMOX_NODE=proxmox
# Storage that holds ISOs and the VM disk.
SOPHON_PROXMOX_ISO_STORAGE=local
SOPHON_PROXMOX_DISK_STORAGE=local-lvm
# Bridge and optional VLAN tag for InfraVM's NIC.
SOPHON_VNET_INTERFACE=vmbr0
SOPHON_VNET_VLAN=
# Password of root@pam (this step only). Prefer leaving blank.
SOPHON_PROXMOX_PASSWORD=

# --- VMware vCenter ------------------------------------------------------------------------------------------
# HTTPS URL of vCenter (not a standalone ESXi), for example https://vcenter.example.com
SOPHON_VCENTER_URL=
# Account that can create VMs and upload to the datastore.
SOPHON_VCENTER_USERNAME=administrator@vsphere.local
SOPHON_VCENTER_PASSWORD=
# Optional CA PEM (path on this laptop) that verifies vCenter. TLS verification is never disabled.
SOPHON_VCENTER_CA_FILE=
# Existing inventory names. The datastore must be shared by the cluster.
SOPHON_VCENTER_DATACENTER=
SOPHON_VCENTER_CLUSTER=
SOPHON_VCENTER_DATASTORE=
# Existing port group that already carries the guest VLAN.
SOPHON_VCENTER_NETWORK=
# Optional existing VM folder (blank uses the datacenter VM root).
SOPHON_VCENTER_FOLDER=

# --- Microsoft Hyper-V ---------------------------------------------------------------------------------------
# Host reachable over WinRM. BLANK (or localhost) means this PC: runs as you, no WinRM, no user name or password.
SOPHON_HYPERV_HOST=
# 5985 = HTTP with NTLM message encryption, 5986 = HTTPS with a verified certificate (remote host only).
SOPHON_HYPERV_PORT=5985
# Account in the remote host's Administrators group (remote host only).
SOPHON_HYPERV_USERNAME=Administrator
SOPHON_HYPERV_PASSWORD=
# Optional CA PEM that verifies the HTTPS listener on 5986 (remote host only).
SOPHON_HYPERV_CA_FILE=
# Existing virtual switch InfraVM connects to. InfraVM needs a static-capable network, so prefer an External switch.
# On this PC you are asked to pick one if blank.
SOPHON_HYPERV_SWITCH=
# Optional folder on the Hyper-V host for the VM, disk and ISOs, for example D:\Hyper-V (blank = host default).
SOPHON_HYPERV_PATH=

# --- InfraVM & Dev/Drill VM sizing (all hypervisors) ---------------------------------------------------------
# Production VM name (`provision`) and dev/restore-drill VM name (`provision-dev`).
# `provision-dev` always deletes any existing SOPHON_DEV_INFRAVM_NAME first while refusing SOPHON_INFRAVM_NAME.
SOPHON_INFRAVM_NAME=sophon-infravm
SOPHON_DEV_INFRAVM_NAME=sophon-dev-infravm
SOPHON_INFRAVM_CORES=8
SOPHON_INFRAVM_MEMORY=12288
SOPHON_INFRAVM_DISK_GB=160

# --- Unattended seed & IPv4 configuration (`secrets`, `provision`, `provision-dev`, `provision-backup`) -----
# Base DNS domain (for example sophon.example.com) and ACME Let's Encrypt contact email.
SOPHON_DOMAIN=
SOPHON_ACME_EMAIL=
# Production InfraVM static IPv4 CIDR, gateway, and upstream DNS (also sets self-DNS to the InfraVM IP).
SOPHON_NETWORK_CIDR=
SOPHON_NETWORK_GATEWAY=
SOPHON_VNET_DNS=1.1.1.1
# Dev / restore-drill InfraVM static IPv4 CIDR (must differ from SOPHON_NETWORK_CIDR; `sophon-activate` switches
# the VM's IP and self-DNS from SOPHON_DEV_NETWORK_CIDR to SOPHON_NETWORK_CIDR when promoting to production).
SOPHON_DEV_NETWORK_CIDR=
# SFTP Backup Server:
# - SOPHON_BACKUP_NETWORK_CIDR configures the static IPv4 interface on Sophon's Alpine SFTP VM (`secrets --with-backup`).
# - SOPHON_KOPIA_SFTP_HOST is the IP or hostname InfraVM connects to for backups (leave blank when using
#   `secrets --with-backup` to default to the IP in SOPHON_BACKUP_NETWORK_CIDR; set when using an existing NAS/SFTP host).
SOPHON_BACKUP_NETWORK_CIDR=
SOPHON_KOPIA_SFTP_HOST=

# --- Certificates & Secrets (prefer leaving blank in `.env` so prompts stay out of disk files) ---------------
# Cloudflare API token for Let's Encrypt DNS-01 (`certificates issue` / Traefik) and optional Cloudflare tunnel + DNS CNAMEs.
SOPHON_CF_TOKEN=
SOPHON_SHARED_PASSWORD=
SOPHON_KOPIA_PASSWORD=


