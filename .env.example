# Sophon settings for steps 1 and 2 (run on your laptop).
#
# Copy this file to `.env` in the project folder and edit it:
#     cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
# sophon-provision.sh / sophon-provision.ps1 read `.env` automatically. Anything you leave out is asked for
# interactively, so an empty or missing `.env` is fine.
#
# Rules: one NAME=value per line, no spaces around "=", no "export", optional quotes around the value, and
# lines starting with # are comments. A variable already set in your shell wins over this file. Only SOPHON_*
# and CF_DNS_API_TOKEN are read. `.env` is git-ignored and never enters the deployment ISO.
#
# Passwords are best left blank (you are prompted and nothing is stored). If you do put one here, keep the file
# private. Step 4 settings (domain, service passwords, certificates) are entered on the InfraVM console instead;
# see docs/inputs.md.

# --- Where InfraVM runs --------------------------------------------------------------------------------------
# proxmox | vcenter | hyperv. Leave blank to be asked from a menu (which also offers "only download and build").
# For Hyper-V on THIS Windows PC (run as the signed-in user, no password) use hyperv and leave SOPHON_HYPERV_HOST blank.
SOPHON_HYPERVISOR=

# --- Proxmox -------------------------------------------------------------------------------------------------
# API host name or address (port below).
SOPHON_PROXMOX_HOST=
# API port.
SOPHON_PROXMOX_PORT=8006
# The real node name shown in the Proxmox tree (usually not "proxmox").
SOPHON_PROXMOX_NODE=proxmox
# Storage that holds ISOs and the VM disk.
SOPHON_PROXMOX_ISO_STORAGE=local
SOPHON_PROXMOX_DISK_STORAGE=local-lvm
# Bridge and optional VLAN tag for InfraVM's NIC.
SOPHON_VNET_INTERFACE=vmbr0
SOPHON_VNET_VLAN=
# Password of root@pam (this step only). Prefer leaving blank.
SOPHON_PROXMOX_PASSWORD=

# --- VMware vCenter ------------------------------------------------------------------------------------------
# HTTPS URL of vCenter (not a standalone ESXi), for example https://vcenter.example.com
SOPHON_VCENTER_URL=
# Account that can create VMs and upload to the datastore.
SOPHON_VCENTER_USERNAME=administrator@vsphere.local
SOPHON_VCENTER_PASSWORD=
# Optional CA PEM (path on this laptop) that verifies vCenter. TLS verification is never disabled.
SOPHON_VCENTER_CA_FILE=
# Existing inventory names. The datastore must be shared by the cluster.
SOPHON_VCENTER_DATACENTER=
SOPHON_VCENTER_CLUSTER=
SOPHON_VCENTER_DATASTORE=
# Existing port group that already carries the guest VLAN.
SOPHON_VCENTER_NETWORK=
# Optional existing VM folder (blank uses the datacenter VM root).
SOPHON_VCENTER_FOLDER=

# --- Microsoft Hyper-V ---------------------------------------------------------------------------------------
# Host reachable over WinRM. BLANK (or localhost) means this PC: runs as you, no WinRM, no user name or password.
SOPHON_HYPERV_HOST=
# 5985 = HTTP with NTLM message encryption, 5986 = HTTPS with a verified certificate (remote host only).
SOPHON_HYPERV_PORT=5985
# Account in the remote host's Administrators group (remote host only).
SOPHON_HYPERV_USERNAME=Administrator
SOPHON_HYPERV_PASSWORD=
# Optional CA PEM that verifies the HTTPS listener on 5986 (remote host only).
SOPHON_HYPERV_CA_FILE=
# Existing virtual switch InfraVM connects to. InfraVM needs a static-capable network, so prefer an External switch.
# On this PC you are asked to pick one if blank.
SOPHON_HYPERV_SWITCH=
# Optional folder on the Hyper-V host for the VM, disk and ISOs, for example D:\Hyper-V (blank = host default).
SOPHON_HYPERV_PATH=

# --- InfraVM sizing (all hypervisors) ------------------------------------------------------------------------
# VM name, CPU cores, memory in MiB, disk in GiB (at least 40). An existing VM is only started if this
# workflow created it; anything else is left alone.
SOPHON_INFRAVM_NAME=sophon-infravm
SOPHON_INFRAVM_CORES=8
SOPHON_INFRAVM_MEMORY=8192
SOPHON_INFRAVM_DISK_GB=100

# --- Certificates (only for `sophon-provision ... certificates issue`) -------------------------------------------
# Cloudflare API token for issuing the offline certificate payload (Zone:Read, DNS:Edit). Prefer leaving blank.
CF_DNS_API_TOKEN=
