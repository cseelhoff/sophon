# Kopia deployed via Portainer Stacks API.
#
# Single-service deployment: a small entrypoint wrapper writes the SFTP key
# + known_hosts to a tmpfs from env vars, does the canonical
# `connect || create` repository bootstrap, applies retention + cron policy
# (idempotent — replays harmlessly on every restart), then exec's into
# `kopia server`. Service-specific backup sidecars (e.g. gitea-backup) write
# consistent dumps into the `kopia_backups` named volume; kopia mounts that
# at /source and its in-process scheduler handles snapshotting, encryption,
# dedup, and retention into the SFTP repo on the NFS VM.

services:
  kopia:
    image: {{ kopia_image }}
    pull_policy: never
    container_name: kopia
    restart: unless-stopped
    environment:
      KOPIA_PASSWORD: "{{ kopia_repository_password }}"
      KOPIA_SERVER_USERNAME: "{{ kopia_admin_user }}"
      KOPIA_SERVER_PASSWORD: "{{ kopia_admin_password }}"
      KOPIA_CHECK_FOR_UPDATES: "false"
      # SFTP credentials passed as multi-line env vars; the entrypoint
      # writes them to a tmpfs with mode 0600 before invoking kopia.
      KOPIA_SFTP_KEY: |
{{ kopia_sftp_private_key | indent(8, true) }}
      KOPIA_SFTP_KNOWN_HOSTS: |
{{ kopia_sftp_known_hosts | indent(8, true) }}
    volumes:
      - kopia_config:/app/config
      - kopia_cache:/app/cache
      - kopia_logs:/app/logs
      - kopia_backups:/source
    # Tmpfs for SSH key + known_hosts (never written to disk).
    # Compose short-form tmpfs only accepts `mode` and `size`; uid/gid are
    # not valid here and the daemon rejects them with "invalid mount
    # option". The container runs as root so uid=0/gid=0 is the default.
    tmpfs:
      - /run/kopia-ssh:mode=700
    networks:
      - proxy
    entrypoint: ["/bin/sh", "-c"]
    # NOTE: every `$` that should reach the in-container shell must be
    # written as `$$` here. Docker Compose performs variable interpolation
    # on `command:` BEFORE submitting the stack to the daemon, using the
    # DEPLOYING host's environment. `$KOPIA_SFTP_KEY` (single $) would be
    # silently replaced with empty string at deploy time, producing an
    # empty key file and a baffling "ssh: no key found" error from kopia.
    # `$$VAR` is Compose's documented escape for a literal `$VAR` that
    # should be expanded inside the running container instead.
    command:
      - |
        set -e
        umask 077
        printf '%s' "$$KOPIA_SFTP_KEY"          > /run/kopia-ssh/id_ed25519
        printf '%s' "$$KOPIA_SFTP_KNOWN_HOSTS"  > /run/kopia-ssh/known_hosts
        chmod 600 /run/kopia-ssh/id_ed25519 /run/kopia-ssh/known_hosts
        kopia repository connect sftp \
          --host={{ kopia_sftp_host }} \
          --port={{ kopia_sftp_port }} \
          --username={{ kopia_sftp_username }} \
          --keyfile=/run/kopia-ssh/id_ed25519 \
          --known-hosts=/run/kopia-ssh/known_hosts \
          --path={{ kopia_sftp_path }} 2>/dev/null || \
        kopia repository create sftp \
          --host={{ kopia_sftp_host }} \
          --port={{ kopia_sftp_port }} \
          --username={{ kopia_sftp_username }} \
          --keyfile=/run/kopia-ssh/id_ed25519 \
          --known-hosts=/run/kopia-ssh/known_hosts \
          --path={{ kopia_sftp_path }}
        kopia policy set --global \
          --keep-latest={{ kopia_keep_latest }} \
          --keep-hourly={{ kopia_keep_hourly }} \
          --keep-daily={{ kopia_keep_daily }} \
          --keep-weekly={{ kopia_keep_weekly }} \
          --keep-monthly={{ kopia_keep_monthly }} \
          --keep-annual={{ kopia_keep_annual }}
        kopia policy set /source --snapshot-time-crontab="{{ kopia_snapshot_cron }}" || true
        exec kopia server start \
          --insecure \
          --address=0.0.0.0:{{ kopia_port }}
    # The image ships curl but NOT wget, and kopia's UI API rejects basic
    # auth (401 even with the server credentials -- it wants a session +
    # CSRF token). So the check asserts only what Traefik actually needs:
    # that the HTTP listener answers. 401 is the expected healthy response.
    # This matters more than it looks -- Traefik's Docker provider silently
    # skips unhealthy containers, so a healthcheck that can never pass makes
    # the service unroutable and returns 404 with nothing in Traefik's log.
    healthcheck:
      test:
        - CMD-SHELL
        - curl -sS -o /dev/null -w '%{http_code}' http://127.0.0.1:{{ kopia_port }}/api/v1/repo/status | grep -qE '^(200|401)$$'
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.kopia.entrypoints=websecure"
      - "traefik.http.routers.kopia.rule=Host(`{{ kopia_hostname }}.{{ kopia_domain }}`)"
      - "traefik.http.routers.kopia.tls=true"
      - "traefik.http.routers.kopia.tls.certresolver=letsencrypt"
      - "traefik.http.services.kopia.loadbalancer.server.port={{ kopia_port }}"

volumes:
  kopia_config:
  kopia_cache:
  kopia_logs:
  # Shared with backup sidecars (e.g. gitea-backup) that dump consistent
  # snapshots here for kopia to pick up.
  kopia_backups:

networks:
  proxy:
    external: true
