
services:
  kopia:
    image: {{ kopia_image_name }}:{{ kopia_image_tag }}
    container_name: kopia
    restart: unless-stopped
    hostname: kopia
{% if kopia_server_enabled %}
    command:
      - server
      - start
      - --insecure
      - --address=0.0.0.0:{{ kopia_port }}
      - --server-username=${KOPIA_SERVER_USERNAME:-{{ kopia_server_username }}}
      - --server-password=${KOPIA_SERVER_PASSWORD}
{% endif %}
    environment:
      - KOPIA_PASSWORD=${KOPIA_PASSWORD}
      - TZ={{ timezone | default('UTC') }}
{% if kopia_repository_type == 's3' %}
      - AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
      - AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
{% endif %}
    ports:
      - "{{ kopia_port }}:{{ kopia_port }}"
    volumes:
      # Kopia configuration and cache
      - {{ kopia_config_dir }}:/app/config
      - {{ kopia_cache_dir }}:/app/cache
      - {{ kopia_logs_dir }}:/app/logs
{% if kopia_repository_type == 'filesystem' %}
      # Repository storage
      - {{ kopia_repository_path }}:/repository
{% endif %}
      # Sources to backup (read-only)
{% for source in kopia_backup_sources %}
      - {{ source }}:{{ source }}:ro
{% endfor %}
    networks:
      - kopia
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.kopia.rule=Host(`kopia.{{ domain_name }}`)"
      - "traefik.http.routers.kopia.entrypoints=websecure"
      - "traefik.http.routers.kopia.tls=true"
      - "traefik.http.services.kopia.loadbalancer.server.port={{ kopia_port }}"
      - "homepage.group=Infrastructure"
      - "homepage.name=Kopia"
      - "homepage.icon=kopia"
      - "homepage.href=https://kopia.{{ domain_name }}"
      - "homepage.description=Filesystem Backup"

networks:
  kopia:
    driver: bridge
