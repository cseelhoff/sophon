services:
  dump-proxy:
    image: {{ kopia_image }}
    pull_policy: never
    container_name: kopia-engine
    user: "0:0"
    restart: unless-stopped
    read_only: true
    cap_drop: [ALL]
    security_opt: ["label=disable", "no-new-privileges:true"]
    entrypoint: ["python3", "/app/dump_proxy.py"]
    tmpfs:
      - /tmp:size=16m,mode=1777
    networks: [backup-engine]
    volumes:
      - /run/user/1000/podman/podman.sock:/socket/podman.sock:ro
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:2375/healthz', timeout=3).read()"]
      interval: 10s
      timeout: 5s
      retries: 6

  kopia:
    image: {{ kopia_image }}
    pull_policy: never
    container_name: kopia
    hostname: sophon-backup
    user: "0:0"
    restart: unless-stopped
    stop_grace_period: 240s
    read_only: true
    cap_drop: [ALL]
    cap_add: [DAC_OVERRIDE, CHOWN, FOWNER]
    security_opt: ["label=disable", "no-new-privileges:true"]
    networks: [proxy, backup-engine]
    depends_on:
      dump-proxy:
        condition: service_healthy
    environment:
      SOURCE_ROOT: /source
      VOLUMES_ROOT: /volumes
      ENGINE_URL: http://dump-proxy:2375
      SOPHON_VERSION: {{ sophon_version | to_json }}
      COMMAND_TIMEOUT: "900"
      KOPIA_PASSWORD: ${KOPIA_PASSWORD:?Set the repository encryption password}
      KOPIA_SERVER_USERNAME: ${KOPIA_SERVER_USERNAME:-admin}
      KOPIA_SERVER_PASSWORD: ${KOPIA_SERVER_PASSWORD:?Set the UI password}
      KOPIA_SERVER_CONTROL_USER: ${KOPIA_SERVER_USERNAME:-admin}
      KOPIA_SERVER_CONTROL_PASSWORD: ${KOPIA_SERVER_PASSWORD:?Set the UI password}
      KOPIA_SFTP_HOST: ${KOPIA_SFTP_HOST:?Set the SFTP host}
      KOPIA_SFTP_PORT: ${KOPIA_SFTP_PORT:-22}
      KOPIA_SFTP_USERNAME: ${KOPIA_SFTP_USERNAME:?Set the SFTP username}
      KOPIA_SFTP_PATH: ${KOPIA_SFTP_PATH:?Set the repository path}
      KOPIA_SFTP_PRIVATE_KEY_B64: ${KOPIA_SFTP_PRIVATE_KEY_B64:?Set the base64 SSH private key}
      KOPIA_SFTP_KNOWN_HOSTS_B64: ${KOPIA_SFTP_KNOWN_HOSTS_B64:?Set the base64 pinned known_hosts}
      KOPIA_CLIENT_USERNAME: ${KOPIA_CLIENT_USERNAME:-backup}
      KOPIA_CLIENT_HOSTNAME: ${KOPIA_CLIENT_HOSTNAME:-sophon}
      KOPIA_BACKUPS_ENABLED: ${KOPIA_BACKUPS_ENABLED:-false}
      KOPIA_READONLY: ${KOPIA_READONLY:-false}
      KOPIA_SNAPSHOT_INTERVAL: ${KOPIA_SNAPSHOT_INTERVAL:-6h}
    tmpfs:
      - /tmp:size=128m,mode=1777
    volumes:
      - config-v3:/config
      - cache-v3:/cache
      - logs-v3:/logs
      - source-v3:/source
      - type: bind
        source: {{ kopia_volumes_dir | to_json }}
        target: /volumes
        read_only: true
    healthcheck:
      test: ["CMD", "python3", "/app/runtime.py", "health"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 120s
    labels:
      traefik.enable: "true"
      traefik.docker.network: proxy
      traefik.http.routers.kopia.rule: "Host(`{{ kopia_fqdn }}`)"
      traefik.http.routers.kopia.entrypoints: websecure
      traefik.http.routers.kopia.tls: "true"
      traefik.http.routers.kopia.tls.certresolver: letsencrypt
      traefik.http.routers.kopia.tls.domains[0].main: "{{ domain_name }}"
      traefik.http.routers.kopia.tls.domains[0].sans: "*.{{ domain_name }}"
      traefik.http.services.kopia.loadbalancer.server.port: "51515"
{% if kopia_coarse_enabled | bool %}

  coarse:
    image: {{ kopia_image }}
    pull_policy: never
    container_name: kopia-coarse
    restart: unless-stopped
    user: "0:0"
    read_only: true
    cap_drop: [ALL]
    cap_add: [DAC_OVERRIDE]
    security_opt: ["label=disable", "no-new-privileges:true"]
    entrypoint: ["python3", "/app/coarse.py"]
    command: [serve]
    stop_grace_period: 240s
    networks: [proxy]
    depends_on:
      kopia:
        condition: service_healthy
    environment:
      SOPHON_VERSION: {{ sophon_version | to_json }}
      KOPIA_CONFIG_PATH: /coarse/config/repository.config
      KOPIA_CACHE_DIRECTORY: /coarse/cache
      KOPIA_LOG_DIR: /coarse/logs
      KOPIA_SERVER_ADDRESS: http://127.0.0.1:51516
      KOPIA_SERVER_USERNAME: ${KOPIA_SERVER_USERNAME:-admin}
      KOPIA_SERVER_PASSWORD: ${KOPIA_SERVER_PASSWORD:?Set the UI password}
      KOPIA_PASSWORD: ${KOPIA_PASSWORD:?Set the repository encryption password}
      KOPIA_SFTP_HOST: ${KOPIA_SFTP_HOST:?Set the SFTP host}
      KOPIA_SFTP_PORT: ${KOPIA_SFTP_PORT:-22}
      KOPIA_SFTP_USERNAME: ${KOPIA_SFTP_USERNAME:?Set the SFTP username}
      KOPIA_SFTP_PATH: ${KOPIA_SFTP_PATH:?Set the repository path}
      KOPIA_SFTP_PRIVATE_KEY_B64: ${KOPIA_SFTP_PRIVATE_KEY_B64:?Set the base64 SSH private key}
      KOPIA_SFTP_KNOWN_HOSTS_B64: ${KOPIA_SFTP_KNOWN_HOSTS_B64:?Set the base64 pinned known_hosts}
      KOPIA_CLIENT_USERNAME: ${KOPIA_CLIENT_USERNAME:-backup}
      KOPIA_CLIENT_HOSTNAME: ${KOPIA_CLIENT_HOSTNAME:-sophon}
    tmpfs:
      - /tmp:size=128m,mode=1777
    volumes:
      - type: bind
        source: {{ kopia_coarse_volumes_dir | to_json }}
        target: /volumes
        read_only: true
      - type: bind
        source: {{ kopia_coarse_work_dir | to_json }}
        target: /coarse
      - source-v3:/source:ro
{% endif %}
networks:
  proxy:
    external: true
  backup-engine:
    internal: true
volumes:
  config-v3:
  cache-v3:
  logs-v3:
  source-v3:
