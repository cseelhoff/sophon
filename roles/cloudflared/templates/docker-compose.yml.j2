services:
  cloudflared:
    image: docker.io/cloudflare/cloudflared:{{ cloudflared_image_tag }}
    pull_policy: never
    container_name: cloudflared
    restart: always
    security_opt:
      - label=disable
    networks:
      - proxy
    environment:
      - TUNNEL_TOKEN={{ cloudflared_token }}
    command: tunnel --no-autoupdate run
    labels:
      - sophon.backup.version=3
      - sophon.backup.group=cloudflared
      - sophon.backup.stop=false
networks:
  proxy:
    external: true
