
services:
  homepage:
    image: {{ homepage_image_name }}:{{ homepage_image_tag }}
    container_name: homepage
    restart: unless-stopped
    ports:
      - "{{ homepage_port }}:3000"
    volumes:
      - {{ homepage_config_dir }}:/app/config
{% if homepage_docker_discovery %}
      - /run/podman/podman.sock:/var/run/docker.sock:ro
{% endif %}
    environment:
      - PUID=1000
      - PGID=1000
    networks:
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.homepage.entrypoints=https"
      - "traefik.http.routers.homepage.rule=Host(`home.{{ traefik_domain | default('example.local') }}`)"
      - "traefik.http.routers.homepage.tls=true"
      - "traefik.http.services.homepage.loadbalancer.server.port=3000"

networks:
  proxy:
    external: true
