variant: fcos
version: 1.5.0

passwd:
  users:
    - name: {{ coreos_base_username }}
      password_hash: {{ coreos_base_password_hash }}
      groups:
        - sudo
        - wheel
{% if bastion_ssh_public_key is defined and bastion_ssh_public_key %}
      ssh_authorized_keys:
        - {{ bastion_ssh_public_key }}
{% endif %}

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ coreos_base_vm_name }}

    - path: /etc/NetworkManager/system-connections/wired.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=Wired connection 1
          type=ethernet
          match-device=type:ethernet

          [ipv4]
{% if coreos_base_ip is defined and coreos_base_ip %}
          address1={{ coreos_base_ip }}/{{ coreos_base_cidr }},{{ coreos_base_gateway }}
          method=manual
{% else %}
          method=auto
{% endif %}
          dns={{ bastion_dns | default('1.1.1.1') }};

    # Cloudflared config (if token provided)
{% if bastion_cloudflared_token is defined and bastion_cloudflared_token %}
    - path: /etc/cloudflared/config.yml
      mode: 0600
      contents:
        inline: |
          tunnel: {{ bastion_cloudflared_tunnel_name }}
          credentials-file: /etc/cloudflared/credentials.json
          ingress:
            - hostname: "*.{{ bastion_cloudflared_domain | default('tunnel.local') }}"
              service: ssh://localhost:22
            - service: http_status:404

    - path: /etc/cloudflared/credentials.json
      mode: 0600
      contents:
        inline: |
          {"tunnel":"{{ bastion_cloudflared_tunnel_name }}","token":"{{ bastion_cloudflared_token }}"}
{% endif %}

    # Setup script to install tools via toolbox/podman
    - path: /usr/local/bin/setup-bastion-tools.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -e
          
          STAMP_FILE="/var/lib/bastion-tools-installed.stamp"
          
          if [ -f "$STAMP_FILE" ]; then
            echo "Bastion tools already installed"
            exit 0
          fi
          
          echo "Installing bastion tools via podman..."
          
          # Pull Alpine container for tooling
          /usr/bin/podman pull docker.io/alpine:latest || true
          
          # Create a persistent container for ansible/tools
          /usr/bin/podman create --name bastion-tools \
            -v /home/{{ coreos_base_username }}:/workspace:z \
            -v /etc/ssl/certs:/etc/ssl/certs:ro \
            docker.io/alpine:latest sleep infinity || true
          
          # Start and install packages in container
          /usr/bin/podman start bastion-tools || true
          /usr/bin/podman exec bastion-tools apk add --no-cache \
            ansible py3-pip py3-requests git curl wget openssh-client rsync || true
          
          # Install Python packages
          /usr/bin/podman exec bastion-tools pip3 install --break-system-packages proxmoxer || true
          
          # Install butane
          curl -fsSL https://github.com/coreos/butane/releases/download/v{{ bastion_butane_version | default('0.23.0') }}/butane-x86_64-unknown-linux-gnu \
            -o /usr/local/bin/butane && chmod +x /usr/local/bin/butane
          
          touch "$STAMP_FILE"
          echo "Bastion tools installation complete"

    # Wrapper script to run ansible via the tools container
    - path: /usr/local/bin/ansible-playbook
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          exec /usr/bin/podman exec -it -w /workspace bastion-tools ansible-playbook "$@"

    - path: /usr/local/bin/ansible
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          exec /usr/bin/podman exec -it -w /workspace bastion-tools ansible "$@"

{% if bastion_clone_sophon | default(true) %}
    # Script to clone Sophon repository
    - path: /usr/local/bin/clone-sophon.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -e
          
          REPO_PATH="{{ bastion_sophon_clone_path | default('/home/' ~ coreos_base_username ~ '/sophon') }}"
          
          if [ -d "$REPO_PATH" ]; then
            echo "Sophon repo already exists at $REPO_PATH"
            exit 0
          fi
          
          echo "Cloning Sophon repository..."
          git clone {{ bastion_sophon_repo_url | default('https://github.com/your-org/sophon.git') }} "$REPO_PATH"
          chown -R {{ coreos_base_username }}:{{ coreos_base_username }} "$REPO_PATH"
          echo "Sophon cloned to $REPO_PATH"
{% endif %}

systemd:
  units:
    # Setup bastion tools at first boot
    - name: setup-bastion-tools.service
      enabled: true
      contents: |
        [Unit]
        Description=Setup bastion tools via podman
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=!/var/lib/bastion-tools-installed.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/setup-bastion-tools.sh

        [Install]
        WantedBy=multi-user.target

{% if bastion_clone_sophon | default(true) %}
    # Clone Sophon repo after tools are installed
    - name: clone-sophon.service
      enabled: true
      contents: |
        [Unit]
        Description=Clone Sophon repository
        After=setup-bastion-tools.service network-online.target
        Wants=network-online.target
        Requires=setup-bastion-tools.service
        ConditionPathExists=/var/lib/bastion-tools-installed.stamp
        ConditionPathExists=!/home/{{ coreos_base_username }}/sophon

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/clone-sophon.sh

        [Install]
        WantedBy=multi-user.target
{% endif %}

{% if bastion_cloudflared_token is defined and bastion_cloudflared_token %}
    # Cloudflared tunnel service
    - name: cloudflared.service
      enabled: true
      contents: |
        [Unit]
        Description=Cloudflared Tunnel
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=simple
        Restart=always
        RestartSec=10
        ExecStartPre=-/usr/bin/podman rm -f cloudflared
        ExecStart=/usr/bin/podman run --rm --name cloudflared \
          --network host \
          -v /etc/cloudflared:/etc/cloudflared:ro \
          docker.io/cloudflare/cloudflared:latest \
          tunnel --config /etc/cloudflared/config.yml run
        ExecStop=/usr/bin/podman stop cloudflared

        [Install]
        WantedBy=multi-user.target
{% endif %}
