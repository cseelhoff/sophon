#cloud-config
# =============================================================================
# Bastion VM Cloud-Init User Data
# =============================================================================
# Configures Alpine Linux as a privileged access workstation for running
# Ansible playbooks against the Sophon infrastructure.

hostname: {{ bastion_vm_name }}
fqdn: {{ bastion_vm_name }}.local

# -----------------------------------------------------------------------------
# User Configuration
# -----------------------------------------------------------------------------
users:
  - name: {{ bastion_username }}
    groups: wheel
    shell: /bin/ash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: {{ bastion_password_hash }}
{% if bastion_ssh_public_key is defined and bastion_ssh_public_key %}
    ssh_authorized_keys:
      - {{ bastion_ssh_public_key }}
{% endif %}

# Disable root login
disable_root: true

# -----------------------------------------------------------------------------
# Package Management
# -----------------------------------------------------------------------------
# Enable community and edge/testing repos for cloudflared
write_files:
  - path: /etc/apk/repositories
    content: |
      https://dl-cdn.alpinelinux.org/alpine/v{{ bastion_alpine_version }}/main
      https://dl-cdn.alpinelinux.org/alpine/v{{ bastion_alpine_version }}/community
      https://dl-cdn.alpinelinux.org/alpine/edge/testing
    permissions: '0644'

{% if bastion_cloudflared_token %}
  - path: /etc/cloudflared/config.yml
    content: |
      tunnel: {{ bastion_cloudflared_tunnel_name }}
      credentials-file: /etc/cloudflared/credentials.json
      ingress:
        - hostname: ssh.{{ bastion_cloudflared_tunnel_name }}.example.com
          service: ssh://localhost:22
        - service: http_status:404
    permissions: '0600'
{% endif %}

  - path: /home/{{ bastion_username }}/.profile
    content: |
      # Sophon Bastion Environment
      export PATH="$PATH:/usr/local/bin"
      
      echo "═══════════════════════════════════════════════════════════"
      echo "  Sophon Bastion - Privileged Access Workstation"
      echo "═══════════════════════════════════════════════════════════"
      echo ""
      echo "  To run Sophon playbooks:"
      echo "    cd ~/sophon"
      echo "    ansible-playbook -i inventories/production/inventory.yml site.yml"
      echo ""
      echo "═══════════════════════════════════════════════════════════"
    permissions: '0644'
    owner: {{ bastion_username }}:{{ bastion_username }}

package_update: true
package_upgrade: true

packages:
{% for pkg in bastion_packages %}
  - {{ pkg }}
{% endfor %}

# -----------------------------------------------------------------------------
# Post-Boot Commands
# -----------------------------------------------------------------------------
runcmd:
  # Install pip packages
{% for pkg in bastion_pip_packages %}
  - pip3 install {{ pkg }}
{% endfor %}

  # Install Butane (CoreOS Ignition transpiler)
  - wget -q -O /usr/local/bin/butane https://github.com/coreos/butane/releases/download/v{{ bastion_butane_version }}/butane-x86_64-unknown-linux-gnu
  - chmod +x /usr/local/bin/butane

  # Install skopeo (for container image downloads)
  - apk add skopeo

  # Install dnf for RPM downloads (from edge/testing)
  - apk add dnf5 || echo "dnf5 not available, skipping"

  # Install Ansible collections
  - su - {{ bastion_username }} -c "ansible-galaxy collection install community.proxmox community.general community.docker ansible.posix --force"

  # Enable and start SSH
  - rc-update add sshd default
  - rc-service sshd start

  # Enable QEMU guest agent
  - rc-update add qemu-guest-agent default
  - rc-service qemu-guest-agent start

{% if bastion_clone_sophon %}
  # Clone Sophon repository
  - su - {{ bastion_username }} -c "git clone {{ bastion_sophon_repo_url }} {{ bastion_sophon_clone_path }} || echo 'Repo already exists or clone failed'"
{% endif %}

{% if bastion_cloudflared_token %}
  # Configure Cloudflared with token
  - cloudflared tunnel install {{ bastion_cloudflared_token }}
  - rc-update add cloudflared default
  - rc-service cloudflared start
{% else %}
  # Cloudflared manual setup reminder
  - echo "Cloudflared not configured. Run 'cloudflared tunnel login' to setup."
{% endif %}

# -----------------------------------------------------------------------------
# Final Message
# -----------------------------------------------------------------------------
final_message: |
  Sophon Bastion is ready!
  System boot took $UPTIME seconds.
  Connect via: ssh {{ bastion_username }}@$(hostname -I | awk '{print $1}')
