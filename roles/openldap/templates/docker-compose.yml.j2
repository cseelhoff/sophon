services:
  certs-dumper:
    image: docker.io/{{ openldap_certs_dumper_image_name }}:{{ openldap_certs_dumper_image_tag }}
    pull_policy: never
    container_name: certs-dumper
    restart: unless-stopped
    networks:
      - proxy
    volumes:
      - acme_data:/data:ro
      - ldap_certs:/output
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.ldap-certs.rule=Host(`{{ openldap_tls_domain }}`)"
      - "traefik.http.routers.ldap-certs.entrypoints=websecure"
      - "traefik.http.routers.ldap-certs.tls=true"
      - "traefik.http.routers.ldap-certs.tls.certresolver=letsencrypt"
      - "traefik.http.routers.ldap-certs.tls.domains[0].main={{ openldap_tls_cert_name }}"
      - "traefik.http.routers.ldap-certs.tls.domains[0].sans=*.{{ openldap_tls_cert_name }}"
      - "traefik.http.services.ldap-certs.loadbalancer.server.port=8666"
    entrypoint: ["/bin/sh", "-ec"]
    command:
      - |
        until [ -s /data/acme.json ] && grep -q '"Certificates"' /data/acme.json; do
          echo "certs-dumper: waiting for certificate data in acme.json..."
          sleep 10
        done
        exec traefik-certs-dumper file --source /data/acme.json --dest /output --version v3 --watch --post-hook "chmod -R a+r /output/private/"

  ldap:
    image: docker.io/{{ openldap_image_name }}:{{ openldap_image_tag }}
    pull_policy: never
    container_name: ldap
    restart: unless-stopped
    networks:
      - proxy
    ports:
      - "{{ openldap_port_ldaps }}:636"
    depends_on:
      certs-dumper:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "ldapsearch -Q -Y EXTERNAL -H ldapi:/// -b '' -s base namingContexts | grep -q namingContexts"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    environment:
      LDAP_INIT_ORG_DN: {{ openldap_base_dn | to_json }}
      LDAP_INIT_ORG_NAME: {{ openldap_domain | to_json }}
      LDAP_INIT_ROOT_USER_DN: {{ ('cn=admin,' ~ openldap_base_dn) | to_json }}
      LDAP_INIT_ROOT_USER_PW: {{ openldap_admin_password | replace('$', '$$') | to_json }}
      LDAP_INIT_ADMIN_GROUP_DN: {{ ('cn=ldap-admins,ou=groups,' ~ openldap_base_dn) | to_json }}
      LDAP_INIT_PPOLICY_DEFAULT_DN: {{ ('cn=default,ou=policies,' ~ openldap_base_dn) | to_json }}
      LDAP_INIT_PPOLICY_PW_MIN_LENGTH: "12"
      LDAP_INIT_PASSWORD_HASH: ARGON2
      LDAP_LOG_LEVELS: {{ openldap_log_level | string | to_json }}
      LDAP_BACKUP_TIME: ""
      LDAP_TLS_ENABLED: "true"
      LDAP_LDAPS_ENABLED: "true"
      LDAP_TLS_VERIFY_CLIENT: never
      LDAP_TLS_CERT_FILE: /run/secrets/ldap/certs/{{ openldap_tls_cert_name }}.crt
      LDAP_TLS_KEY_FILE: /run/secrets/ldap/private/{{ openldap_tls_cert_name }}.key
      LDAP_TLS_CA_FILE: /run/secrets/ldap/certs/{{ openldap_tls_cert_name }}.crt
      SOPHON_SERVICE_PASSWORD: {{ openldap_keycloak_password | replace('$', '$$') | to_json }}
      SOPHON_USER_PASSWORD: {{ openldap_example_user_password | replace('$', '$$') | to_json }}
      SOPHON_ADMIN_PASSWORD: {{ openldap_example_admin_password | replace('$', '$$') | to_json }}
    labels:
      - "coredns.dockerdiscovery.host={{ openldap_tls_domain }}"
    volumes:
      - openldap_database:/var/lib/ldap
      - openldap_config:/etc/ldap/slapd.d
      - openldap_data:/var/lib/sophon-legacy:ro
      - ldap_certs:/run/secrets/ldap:ro
    entrypoint: ["/usr/bin/tini", "--", "/bin/bash", "-ec"]
    command:
      - |
        legacy_entry=$$(find /var/lib/sophon-legacy -mindepth 1 -maxdepth 1 -print -quit)
        if [ -n "$$legacy_entry" ]; then
          echo "ldap: legacy Bitnami data found; export and migrate it before starting this image. See docs/inputs.md." >&2
          exit 1
        fi
        for i in $$(seq 1 60); do
          if [ -s "$$LDAP_TLS_CERT_FILE" ] && [ -s "$$LDAP_TLS_KEY_FILE" ]; then
            break
          fi
          echo "ldap: waiting for the TLS certificate and key..."
          sleep 5
        done
        if [ ! -s "$$LDAP_TLS_CERT_FILE" ] || [ ! -s "$$LDAP_TLS_KEY_FILE" ]; then
          echo "ldap: TLS certificate or key is missing after 300 seconds." >&2
          exit 1
        fi

        # Use the vendor's bootstrap and persistent config, but not its sample accounts.
        SOPHON_SERVICE_HASH=$$(printf '%s' "$$SOPHON_SERVICE_PASSWORD" | slappasswd -o module-path=/usr/lib/ldap -o module-load=argon2 -h '{ARGON2}' -T /dev/stdin)
        SOPHON_USER_HASH=$$(printf '%s' "$$SOPHON_USER_PASSWORD" | slappasswd -o module-path=/usr/lib/ldap -o module-load=argon2 -h '{ARGON2}' -T /dev/stdin)
        SOPHON_ADMIN_HASH=$$(printf '%s' "$$SOPHON_ADMIN_PASSWORD" | slappasswd -o module-path=/usr/lib/ldap -o module-load=argon2 -h '{ARGON2}' -T /dev/stdin)
        export SOPHON_SERVICE_HASH SOPHON_USER_HASH SOPHON_ADMIN_HASH
        unset SOPHON_SERVICE_PASSWORD SOPHON_USER_PASSWORD SOPHON_ADMIN_PASSWORD
        sed -i 's/groupOfUniqueNames/groupOfNames/g; s/uniqueMember/member/g' /opt/ldifs/init_mdb_acls.ldif
        sed -i 's/olcMemberOfGroupOC: groupOfUniqueNames/olcMemberOfGroupOC: groupOfNames/; s/olcMemberOfMemberAD: uniqueMember/olcMemberOfMemberAD: member/' /opt/ldifs/init_module_memberof.ldif
        # Display names and POSIX primary groups need not be unique across users.
        sed -i '/^olcUniqueURI: .*?cn?sub$/d; /^olcUniqueURI: .*?gidNumber?sub$/d; s@ldap:///ou=Users,@ldap:///ou=people,@g' /opt/ldifs/init_module_unique.ldif
        cat > /opt/ldifs/init_org_tree.ldif <<'EOF'
        dn: {{ openldap_base_dn }}
        objectClass: top
        objectClass: dcObject
        objectClass: organization
        dc: {{ openldap_domain.split('.')[0] }}
        o: {{ openldap_domain }}

        dn: ou=people,{{ openldap_base_dn }}
        objectClass: organizationalUnit
        ou: people

        dn: ou=groups,{{ openldap_base_dn }}
        objectClass: organizationalUnit
        ou: groups

        dn: ou=services,{{ openldap_base_dn }}
        objectClass: organizationalUnit
        ou: services
        EOF
        cat > /opt/ldifs/init_org_ppolicy.ldif <<'EOF'
        dn: ou=policies,{{ openldap_base_dn }}
        objectClass: organizationalUnit
        ou: policies

        dn: cn=default,ou=policies,{{ openldap_base_dn }}
        objectClass: pwdPolicy
        objectClass: organizationalRole
        cn: default
        pwdAttribute: userPassword
        pwdCheckQuality: 1
        pwdMinLength: 12
        pwdInHistory: 5
        pwdMustChange: FALSE
        pwdAllowUserChange: TRUE
        pwdExpireWarning: 604800
        pwdMaxAge: 0
        EOF
        cat > /opt/ldifs/init_org_entries.ldif <<'EOF'
        dn: cn=keycloak-bind,ou=services,{{ openldap_base_dn }}
        objectClass: inetOrgPerson
        objectClass: simpleSecurityObject
        cn: keycloak-bind
        sn: keycloak-bind
        uid: keycloak-bind
        userPassword: $${SOPHON_SERVICE_HASH}

        dn: uid={{ openldap_example_user_uid }},ou=people,{{ openldap_base_dn }}
        objectClass: inetOrgPerson
        objectClass: posixAccount
        objectClass: shadowAccount
        uid: {{ openldap_example_user_uid }}
        cn: {{ openldap_example_user_givenname }} {{ openldap_example_user_sn }}
        sn: {{ openldap_example_user_sn }}
        givenName: {{ openldap_example_user_givenname }}
        displayName: {{ openldap_example_user_givenname }} {{ openldap_example_user_sn }}
        mail: {{ openldap_example_user_uid }}@{{ openldap_domain }}
        uidNumber: {{ openldap_example_user_uidnumber }}
        gidNumber: 10000
        homeDirectory: /home/{{ openldap_example_user_uid }}
        loginShell: /bin/bash
        userPassword: $${SOPHON_USER_HASH}

        dn: uid={{ openldap_example_admin_uid }},ou=people,{{ openldap_base_dn }}
        objectClass: inetOrgPerson
        objectClass: posixAccount
        objectClass: shadowAccount
        uid: {{ openldap_example_admin_uid }}
        cn: {{ openldap_example_admin_givenname }} {{ openldap_example_admin_sn }}
        sn: {{ openldap_example_admin_sn }}
        givenName: {{ openldap_example_admin_givenname }}
        displayName: {{ openldap_example_admin_givenname }} {{ openldap_example_admin_sn }}
        mail: {{ openldap_example_admin_uid }}@{{ openldap_domain }}
        uidNumber: {{ openldap_example_admin_uidnumber }}
        gidNumber: 10000
        homeDirectory: /home/{{ openldap_example_admin_uid }}
        loginShell: /bin/bash
        userPassword: $${SOPHON_ADMIN_HASH}

        dn: cn=people,ou=groups,{{ openldap_base_dn }}
        objectClass: groupOfNames
        cn: people
        member: cn=keycloak-bind,ou=services,{{ openldap_base_dn }}
        member: uid={{ openldap_example_user_uid }},ou=people,{{ openldap_base_dn }}
        member: uid={{ openldap_example_admin_uid }},ou=people,{{ openldap_base_dn }}

        dn: cn=ldap-admins,ou=groups,{{ openldap_base_dn }}
        objectClass: groupOfNames
        cn: ldap-admins
        member: cn=keycloak-bind,ou=services,{{ openldap_base_dn }}
        member: uid={{ openldap_example_admin_uid }},ou=people,{{ openldap_base_dn }}

        dn: cn=portainer-admins,ou=groups,{{ openldap_base_dn }}
        objectClass: groupOfNames
        cn: portainer-admins
        member: cn=keycloak-bind,ou=services,{{ openldap_base_dn }}
        member: uid={{ openldap_example_admin_uid }},ou=people,{{ openldap_base_dn }}

        dn: cn=posix-users,ou=groups,{{ openldap_base_dn }}
        objectClass: posixGroup
        cn: posix-users
        gidNumber: 10000
        memberUid: {{ openldap_example_user_uid }}
        memberUid: {{ openldap_example_admin_uid }}
        EOF
        exec /bin/bash /opt/run.sh

volumes:
  openldap_data:
  openldap_database:
  openldap_config:
  ldap_certs:
  acme_data:
    external: true
    name: {{ openldap_traefik_acme_volume }}

networks:
  proxy:
    external: true
