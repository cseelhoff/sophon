services:
{% if openldap_tls_enabled %}
  certs-dumper:
    image: docker.io/{{ openldap_certs_dumper_image_name }}:{{ openldap_certs_dumper_image_tag }}
    container_name: certs-dumper
    restart: unless-stopped
    networks:
      - proxy
    volumes:
      - acme_data:/data:ro
      - ldap_certs:/output
    command: file --source /data/acme.json --dest /output --version v2 --watch --post-hook "chmod -R a+r /output/private/"
    healthcheck:
      test: ["CMD-SHELL", "test -f /output/certs/{{ openldap_tls_domain }}.crt"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s

{% endif %}
  ldap:
    container_name: ldap
    image: docker.io/{{ openldap_image_name }}:{{ openldap_image_tag }}
    restart: always
    networks:
      - proxy
    ports:
      - "{{ openldap_port_ldaps }}:636"
    healthcheck:
      test: ["CMD-SHELL", "ldapsearch -Q -Y EXTERNAL -H ldapi://%2Fopt%2Fbitnami%2Fopenldap%2Fvar%2Frun%2Fldapi -b '' -s base namingContexts 2>/dev/null | grep -q namingContexts"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 15s
{% if openldap_tls_enabled %}
    depends_on:
      certs-dumper:
        condition: service_healthy
{% endif %}
    environment:
      - LDAP_ROOT={{ openldap_base_dn }}
      - LDAP_ADMIN_USERNAME=admin
      - LDAP_ADMIN_PASSWORD={{ openldap_admin_password }}
      - LDAP_LOGLEVEL={{ openldap_log_level }}
      - LDAP_PORT_NUMBER={{ openldap_port_ldap }}
      - LDAP_LDAPS_PORT_NUMBER={{ openldap_port_ldaps }}
      - LDAP_ALLOW_ANON_BINDING=no
{% if openldap_tls_enabled %}
      - LDAP_ENABLE_TLS=yes
      # REQUIRE_TLS=no: olcSecurity tls=1 blocks ldapi:// (Unix socket can't do TLS).
      # TLS is still enforced externally — only port 636 (LDAPS) is published.
      - LDAP_REQUIRE_TLS=no
      - LDAP_TLS_CERT_FILE=/opt/bitnami/openldap/certs/certs/{{ openldap_tls_domain }}.crt
      - LDAP_TLS_KEY_FILE=/opt/bitnami/openldap/certs/private/{{ openldap_tls_domain }}.key
      - LDAP_TLS_CA_FILE=/opt/bitnami/openldap/certs/certs/{{ openldap_tls_domain }}.crt
{% endif %}
      - LDAP_CONFIG_ADMIN_ENABLED=yes
      - LDAP_CONFIG_ADMIN_USERNAME=configadmin
      - LDAP_CONFIG_ADMIN_PASSWORD={{ openldap_config_password | default(openldap_admin_password) }}
      - LDAP_SKIP_DEFAULT_TREE=no
      - LDAP_USERS=
      - LDAP_PASSWORDS=
    volumes:
      - openldap_data:/bitnami/openldap
{% if openldap_tls_enabled %}
      - ldap_certs:/opt/bitnami/openldap/certs:ro
{% endif %}
    entrypoint: ["/bin/bash", "-c"]


    command:
      - |
        /opt/bitnami/scripts/openldap/entrypoint.sh /opt/bitnami/scripts/openldap/run.sh &
        SLAPD_PID=$$!

        LDAPI_URL="ldapi://%2Fopt%2Fbitnami%2Fopenldap%2Fvar%2Frun%2Fldapi"

        echo "Waiting for slapd to be ready..."
        for i in $$(seq 1 40); do
          ldapsearch -Q -Y EXTERNAL -H "$$LDAPI_URL" -b '' -s base namingContexts >/dev/null 2>&1 && break
          echo "Attempt $$i/40..."
          sleep 2
        done

        EXISTING=$$(ldapsearch -Q -Y EXTERNAL -H "$$LDAPI_URL" -b "olcDatabase={2}mdb,cn=config" -LLL olcAccess 2>/dev/null | grep -c olcAccess || true)
        if [ "$$EXISTING" -gt 0 ]; then
          echo "ACLs already configured, skipping."
        else
          echo "Applying ACL rules..."
          ldapmodify -Q -Y EXTERNAL -H "$$LDAPI_URL" <<EOF
        dn: olcDatabase={2}mdb,cn=config
        changetype: modify
        add: olcAccess
        olcAccess: {0}to * by dn.exact=gidNumber=0+uidNumber=1001,cn=peercred,cn=external,cn=auth manage by * break
        olcAccess: {1}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,{{ openldap_base_dn }}" write by anonymous auth by * none
        olcAccess: {2}to * by self read by dn="cn=admin,{{ openldap_base_dn }}" write by * read
        EOF

          if [ $$? -eq 0 ]; then
            echo "ACLs applied successfully."
          else
            echo "Failed to apply ACLs."
          fi
        fi

        # ────────────────────────────────────────────────────────────────
        # Add POSIX groups so LAM's Unix module detects them (fixes "no unix groups exist")
        # ────────────────────────────────────────────────────────────────

        echo "Ensuring ou=groups exists..."
        ldapadd -Q -Y EXTERNAL -H "$$LDAPI_URL" <<EOF || true
        dn: ou=groups,{{ openldap_base_dn }}
        objectClass: organizationalUnit
        ou: groups
        EOF

        echo "Creating default posixGroup 'users' (gid 10000) if missing..."
        ldapadd -Q -Y EXTERNAL -H "$$LDAPI_URL" <<EOF || true
        dn: cn=users,ou=groups,{{ openldap_base_dn }}
        objectClass: posixGroup
        objectClass: top
        cn: users
        gidNumber: 10000
        description: Default POSIX users group for UNIX/LAM integration
        EOF

        echo "Creating posixGroup 'admins' (gid 10001) if missing + add admin as member..."
        ldapadd -Q -Y EXTERNAL -H "$$LDAPI_URL" <<EOF || true
        dn: cn=admins,ou=groups,{{ openldap_base_dn }}
        objectClass: posixGroup
        objectClass: top
        cn: admins
        gidNumber: 10001
        description: POSIX admins group
        memberUid: admin
        EOF

        # Optional: If you want the default Bitnami 'readers' group to also be POSIX-capable,
        # you could add gidNumber to it here, but since Bitnami uses groupOfNames by default,
        # it's cleaner to keep separate posixGroups for LAM/UNIX use.

        echo "POSIX groups setup complete."

        # ────────────────────────────────────────────────────────────────
        # Enable memberof overlay for reverse group membership (memberOf attr on users)
        # ────────────────────────────────────────────────────────────────

        echo "Loading memberof module if not already loaded..."
        ldapmodify -Q -Y EXTERNAL -H "$LDAPI_URL" <<EOF || true
        dn: cn=module{0},cn=config
        changetype: modify
        add: olcModuleLoad
        olcModuleLoad: memberof
        -
        add: olcModuleLoad
        olcModuleLoad: refint   # Optional but recommended: referential integrity for clean deletes
        EOF

        # If module{0} already exists and load fails, try as module{1} or higher (Bitnami may have refint/refint already)
        # Alternative safe idempotent way: check first
        MODULE_LOADED=$$(ldapsearch -Q -Y EXTERNAL -H "$LDAPI_URL" -b "cn=module{0},cn=config" -LLL olcModuleLoad 2>/dev/null | grep -c memberof || true)
        if [ "$$MODULE_LOADED" -eq 0 ]; then
          echo "Adding memberof to module list..."
          ldapmodify -Q -Y EXTERNAL -H "$LDAPI_URL" <<EOF || true
        dn: cn=module{0},cn=config
        changetype: modify
        add: olcModuleLoad
        olcModuleLoad: memberof
        EOF
        fi

        echo "Enabling memberof overlay on database if missing..."
        ldapadd -Q -Y EXTERNAL -H "$LDAPI_URL" <<EOF || true
        dn: olcOverlay=memberof,olcDatabase={2}mdb,cn=config
        objectClass: olcOverlayConfig
        objectClass: olcMemberOf
        objectClass: top
        olcOverlay: memberof
        olcMemberOfDangling: ignore          # Don't error on dangling refs (safe default)
        olcMemberOfRefInt: TRUE              # Enable referential integrity (clean up on delete)
        olcMemberOfGroupOC: groupOfNames     # Trigger on this group class (your app groups)
        olcMemberOfMemberAD: member          # Membership attr in groups
        olcMemberOfMemberOfAD: memberOf      # Reverse attr on users
        EOF

        echo "memberof overlay setup attempted (check logs for errors)."

        wait $$SLAPD_PID
    labels:
      - "coredns.dockerdiscovery.host={{ openldap_tls_domain }}"
{% if openldap_tls_enabled %}
      - "traefik.http.routers.ldap-certs.rule=Host(`{{ openldap_tls_domain }}`)"
      - "traefik.http.routers.ldap-certs.entrypoints=websecure"
      - "traefik.http.routers.ldap-certs.tls=true"
      - "traefik.http.routers.ldap-certs.tls.certresolver=letsencrypt"
{% endif %}

  lam:
    image: ghcr.io/{{ openldap_lam_image_name }}:{{ openldap_lam_image_tag }}
    container_name: lam
    restart: always
    networks:
      - proxy
    environment:
      - LAM_SKIP_PRECONFIGURE=false
      - LDAP_DOMAIN={{ openldap_domain }}
      - LDAP_BASE_DN={{ openldap_base_dn }}
      - LDAP_ADMIN_PASSWORD={{ openldap_admin_password }}
{% if openldap_tls_enabled %}
      - LDAP_SERVER=ldaps://{{ openldap_tls_domain }}
{% else %}
      - LDAP_SERVER=ldap://ldap
{% endif %}
      - LAM_LANG=en_US
      - LAM_PASSWORD={{ openldap_admin_password }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.lam.rule=Host(`lam.{{ openldap_domain }}`)"
      - "traefik.http.routers.lam.entrypoints=websecure"
      - "traefik.http.routers.lam.tls=true"
      - "traefik.http.routers.lam.tls.certresolver=letsencrypt"
      - "traefik.http.services.lam.loadbalancer.server.port=80"
      - "coredns.dockerdiscovery.cf_tunnel=https://lam.{{ openldap_domain }}"

volumes:
  openldap_data:
{% if openldap_tls_enabled %}
  ldap_certs:
  acme_data:
    external: true
    name: {{ openldap_traefik_acme_volume }}
{% endif %}

networks:
  proxy:
    external: true
