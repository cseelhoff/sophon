version: '3'

services:
  n8n:
    image: {{ n8n_image_name }}:{{ n8n_image_tag }}
    container_name: n8n
    restart: unless-stopped
    user: "1000:1000"
    environment:
      - N8N_HOST={{ n8n_hostname }}.{{ n8n_domain }}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - WEBHOOK_URL={{ n8n_webhook_url }}
      - GENERIC_TIMEZONE={{ n8n_timezone }}
      - TZ={{ n8n_timezone }}
{% if n8n_basic_auth_enabled %}
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER=${N8N_BASIC_AUTH_USER}
      - N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD}
{% endif %}
      - N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
      - EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS={{ n8n_executions_data_save_manual | lower }}
      - EXECUTIONS_DATA_SAVE_ON_ERROR={{ n8n_executions_data_save_on_error }}
      - EXECUTIONS_DATA_SAVE_ON_SUCCESS={{ n8n_executions_data_save_on_success }}
{% if n8n_oidc_enabled %}
      # OIDC/SSO Configuration
      - N8N_SSO_ENABLED=true
      - N8N_SSO_SAML_ENABLED=false
      - N8N_SSO_OIDC_ENABLED=true
      - N8N_SSO_OIDC_CLIENT_ID={{ n8n_oidc_client_id }}
      - N8N_SSO_OIDC_CLIENT_SECRET=${N8N_OIDC_CLIENT_SECRET}
      - N8N_SSO_OIDC_ISSUER={{ n8n_oidc_issuer_url }}
{% endif %}
    volumes:
      - {{ n8n_data_dir }}/data:/home/node/.n8n
    ports:
      - "{{ n8n_port }}:5678"
    networks:
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.n8n.entrypoints=https"
      - "traefik.http.routers.n8n.rule=Host(`{{ n8n_hostname }}.{{ n8n_domain }}`)"
      - "traefik.http.routers.n8n.tls=true"
      - "traefik.http.routers.n8n.tls.certresolver=letsencrypt"
      - "traefik.http.services.n8n.loadbalancer.server.port=5678"
      - "homepage.group=Services"
      - "homepage.name=n8n"
      - "homepage.icon=n8n"
      - "homepage.href=https://{{ n8n_hostname }}.{{ n8n_domain }}"
      - "homepage.description=Workflow Automation"

networks:
  proxy:
    external: true
