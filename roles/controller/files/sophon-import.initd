#!/sbin/openrc-run
description="Import the offline Sophon deployment into persistent storage"
command=/usr/local/sbin/sophon-import
command_background=yes
pidfile=/run/sophon-import.pid
start_stop_daemon_args="--make-pidfile"
depend() {
    need localmount cgroups
    after networking qemu-guest-agent
    before nfs
}
start_pre() {
    # A fresh image boots before QGA has supplied its nonsecret site settings.
    [ -f /etc/sophon/controller-ip ] && [ -f /etc/sophon/portainer-tar ]
}
