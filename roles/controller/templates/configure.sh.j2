#!/bin/sh
set -eu
test "$(cat /etc/sophon-controller-marker)" = {{ controller_marker | quote }}
umask 077
mkdir -p /etc/sophon /var/lib/sophon /home/operator/.ssh
printf '%s' {{ controller_ssh_public_key | b64encode | quote }} | base64 -d > /home/operator/.ssh/authorized_keys
chmod 700 /home/operator/.ssh
chmod 600 /home/operator/.ssh/authorized_keys
chown -R operator:operator /home/operator/.ssh
chown operator:operator /home/operator
printf '%s' {{ ('operator:' ~ controller_console_password ~ '\n') | b64encode | quote }} | base64 -d | chpasswd
printf '%s\n' {{ nfs_ip | quote }} > /etc/sophon/controller-ip
printf '%s\n' {{ (nfs_ip ~ '/' ~ (vnet_cidr | string)) | quote }} > /etc/sophon/controller-network
printf '%s\n' {{ portainer_image_tarname | quote }} > /etc/sophon/portainer-tar
{% if controller_existing | length == 0 %}
# Only a VM created in this invocation receives permission to initialize a blank disk.
printf '%s\n' {{ controller_marker | quote }} > /var/lib/sophon/allow-data-format
{% endif %}
printf '%s\n' \
  'auto lo' 'iface lo inet loopback' '' \
  'auto eth0' 'iface eth0 inet static' \
  {{ ('  address ' ~ nfs_ip ~ '/' ~ (vnet_cidr | string)) | quote }} \
  {{ ('  gateway ' ~ vnet_gateway) | quote }} > /etc/network/interfaces
printf '%s\n' {{ ('nameserver ' ~ controller_dns) | quote }} > /etc/resolv.conf
ip address replace {{ (nfs_ip ~ '/' ~ (vnet_cidr | string)) | quote }} dev eth0
ip link set eth0 up
ip route replace default via {{ vnet_gateway | quote }} dev eth0
ssh-keygen -A
rc-service sshd restart
# The import runs independently of QGA and may take many minutes.
rm -f /var/lib/sophon/controller-ready /var/lib/sophon/controller-failed
rc-service sophon-import restart
