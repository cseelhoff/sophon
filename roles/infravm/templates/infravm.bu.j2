variant: fcos
version: 1.5.0

passwd:
  users:
    - name: {{ infravm_username }}
      password_hash: {{ infravm_password_hash }}
      ssh_authorized_keys:
        - {{ infravm_ssh_public_key }}
      groups:
        - sudo
        - wheel

storage:
  directories:
    - path: /var/mnt/nfs
      mode: 0755
    # Enable lingering for core user (for rootless podman services)
    - path: /var/lib/systemd/linger
      mode: 0755

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ infravm_vm_name }}

    # Allow unprivileged users to bind to privileged ports (for rootless podman)
    - path: /etc/sysctl.d/99-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: |
          # Allow rootless containers to bind to privileged ports (e.g., port 53 for CoreDNS)
          net.ipv4.ip_unprivileged_port_start=0

    # Enable lingering for core user
    - path: /var/lib/systemd/linger/{{ infravm_username }}
      mode: 0644
      contents:
        inline: ""

    # Disable systemd-resolved stub listener so CoreDNS can bind port 53
    - path: /etc/systemd/resolved.conf.d/nostub.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          DNSStubListener=no

    - path: /etc/NetworkManager/system-connections/wired.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=Wired connection 1
          type=ethernet
          match-device=type:ethernet

          [ipv4]
          address1={{ infravm_ip }}/{{ vnet_cidr }},{{ vnet_gateway }}
          dns=127.0.0.1;{{ vnet_dns }};
          method=manual

  links:
    # Enable podman.socket for all user sessions (activated by lingering)
    - path: /etc/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket

systemd:
  units:
    # Enable rpcbind for NFS client
    - name: rpcbind.socket
      enabled: true

    # NFS mount for container images
    - name: var-mnt-nfs.mount
      enabled: true
      contents: |
        [Unit]
        Description=NFS mount for Sophon artifacts
        After=network-online.target rpcbind.socket
        Wants=network-online.target
        Requires=rpcbind.socket

        [Mount]
        What={{ nfs_ip }}:/export
        Where=/var/mnt/nfs
        Type=nfs4
        Options={{ infravm_nfs_mount_options | default('rw,noatime,vers=4.1') }}

        [Install]
        WantedBy=multi-user.target

    # Sophon init: load container images and start rootless containers
    # Containers use --restart=always so podman + lingering keeps them
    # running across reboots without per-container systemd units.
    - name: sophon-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Sophon container init (load images and start containers)
        After=var-mnt-nfs.mount network-online.target systemd-logind.service user@1000.service
        Wants=var-mnt-nfs.mount network-online.target
        Requires=user@1000.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        User={{ infravm_username }}
        Environment=XDG_RUNTIME_DIR=/run/user/1000
        Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
        Environment=HOME=/var/home/{{ infravm_username }}
        # Load container images from NFS
        # ExecStart=/bin/sh -c 'for tarfile in /var/mnt/nfs/containers/*.tar; do podman load -i "$tarfile" || true; done'

        # Create shared proxy network for inter-stack communication
        ExecStart=/bin/sh -c 'podman network exists proxy || podman network create --label com.docker.compose.network=proxy proxy'

        # Start Portainer (rootless, restart=always for linger persistence)
        ExecStart=/bin/sh -c '\
          podman load -i /var/mnt/nfs/containers/portainer-portainer-ce_2.27.1.tar || true; \
          if podman ps --format "{% raw %}{{.Names}}{% endraw %}" | grep -q "^portainer$"; then \
            echo "PORTAINER_ALREADY_RUNNING"; \
          else \
            podman rm -f portainer 2>/dev/null || true; \
            podman volume create portainer_data 2>/dev/null || true; \
            podman run -d \
              --name portainer \
              --restart always \
              --security-opt label=disable \
              -p {{ infravm_portainer_port }}:9443 \
              -v /run/user/1000/podman/podman.sock:/var/run/docker.sock \
              -v portainer_data:/data:Z \
              docker.io/portainer/portainer-ce:2.27.1 && \
            echo "PORTAINER_STARTED"; \
          fi'

        [Install]
        WantedBy=multi-user.target
