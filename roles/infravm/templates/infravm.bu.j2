variant: fcos
version: 1.5.0

passwd:
  users:
    - name: {{ infravm_username }}
      password_hash: {{ infravm_password_hash }}
      ssh_authorized_keys:
        - {{ infravm_ssh_public_key }}
      groups:
        - sudo
        - wheel

storage:
  directories:
    - path: /var/mnt/nfs
      mode: 0755
    # Enable lingering for core user (for rootless podman services)
    - path: /var/lib/systemd/linger
      mode: 0755

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ infravm_vm_name }}

    # Allow unprivileged users to bind to privileged ports (for rootless podman)
    - path: /etc/sysctl.d/99-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: |
          # Allow rootless containers to bind to privileged ports (e.g., port 53 for CoreDNS)
          net.ipv4.ip_unprivileged_port_start=0

    # Enable lingering for core user
    - path: /var/lib/systemd/linger/{{ infravm_username }}
      mode: 0644
      contents:
        inline: ""

    # Disable systemd-resolved stub listener so CoreDNS can bind port 53
    - path: /etc/systemd/resolved.conf.d/nostub.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          DNSStubListener=no

    - path: /etc/NetworkManager/system-connections/wired.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=Wired connection 1
          type=ethernet
          match-device=type:ethernet

          [ipv4]
          address1={{ infravm_ip }}/{{ proxmox_cidr }},{{ proxmox_vnet_gateway }}
          dns={{ proxmox_vnet_gateway }};8.8.8.8;
          method=manual

systemd:
  units:
    # Enable rpcbind for NFS client
    - name: rpcbind.socket
      enabled: true

    # NFS mount for container images
    - name: var-mnt-nfs.mount
      enabled: true
      contents: |
        [Unit]
        Description=NFS mount for Sophon artifacts
        After=network-online.target rpcbind.socket
        Wants=network-online.target
        Requires=rpcbind.socket

        [Mount]
        What={{ nfs_ip }}:/export
        Where=/var/mnt/nfs
        Type=nfs4
        Options={{ infravm_nfs_mount_options | default('rw,noatime,vers=4.1') }}

        [Install]
        WantedBy=multi-user.target

{% if infravm_cloudflared_tunnel_token | default('') != '' %}
    # Load cloudflared image from NFS or pull from registry (runs once at first boot)
    - name: load-cloudflared-image.service
      enabled: true
      contents: |
        [Unit]
        Description=Load cloudflared container image
        After=var-mnt-nfs.mount network-online.target
        Wants=var-mnt-nfs.mount network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/sh -c 'test -f /var/mnt/nfs/containers/cloudflare-cloudflared_latest.tar && podman load -i /var/mnt/nfs/containers/cloudflare-cloudflared_latest.tar || podman pull {{ infravm_cloudflared_image }}'

        [Install]
        WantedBy=multi-user.target

    # Cloudflared tunnel container service
    - name: cloudflared.service
      enabled: true
      contents: |
        [Unit]
        Description=Cloudflared Tunnel Container
        After=network-online.target load-cloudflared-image.service
        Wants=network-online.target

        [Service]
        TimeoutStartSec=0
        ExecStartPre=-/usr/bin/podman rm -f cloudflared
        ExecStart=/usr/bin/podman run --name cloudflared --network host --rm {{ infravm_cloudflared_image }} tunnel --no-autoupdate run --token {{ infravm_cloudflared_tunnel_token }}
        ExecStop=/usr/bin/podman stop -t 10 cloudflared
        Restart=always
        RestartSec=5s

        [Install]
        WantedBy=multi-user.target
{% endif %}
