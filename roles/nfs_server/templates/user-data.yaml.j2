#cloud-config
# =============================================================================
# NFS Server Cloud-Init User Data
# =============================================================================
# Configures Alpine Linux as a lightweight NFS server with automatic disk
# provisioning and Nexus-compatible export structure.

hostname: {{ nfs_server_vm_name }}
fqdn: {{ nfs_server_vm_name }}.local

# -----------------------------------------------------------------------------
# User Configuration (minimal - NFS server doesn't need interactive access)
# -----------------------------------------------------------------------------
users:
  - name: root
    lock_passwd: true

# Disable SSH by default (NFS server doesn't need it)
ssh_pwauth: false

# -----------------------------------------------------------------------------
# Package Management
# -----------------------------------------------------------------------------
write_files:
  - path: /etc/apk/repositories
    content: |
      https://dl-cdn.alpinelinux.org/alpine/v{{ nfs_server_alpine_version }}/main
      https://dl-cdn.alpinelinux.org/alpine/v{{ nfs_server_alpine_version }}/community
    permissions: '0644'

  - path: /etc/exports
    content: |
      # Sophon NFS Exports
      # Auto-generated by cloud-init
{% for path in nfs_server_export_paths %}
      {{ path }} *({{ nfs_server_export_options }})
{% endfor %}
    permissions: '0644'

  - path: /usr/local/bin/provision-nfs-disk.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      # =============================================================================
      # NFS Disk Provisioning Script
      # =============================================================================
      # Automatically detects, formats, and mounts the NFS data disk (/dev/vdb)
      # SAFETY: Only formats disk if it has NO partition table. Existing partitions
      #         are NEVER deleted to prevent accidental data loss.
      
      set -e
      
      DISK="/dev/vdb"
      PARTITION="${DISK}1"
      MOUNT_POINT="{{ nfs_server_export_root }}"
      
      echo "=== NFS Disk Provisioning ==="
      echo "Disk: $DISK"
      echo "Mount point: $MOUNT_POINT"
      
      # Wait for disk to appear (cloud-init may run before disk is ready)
      for i in $(seq 1 30); do
        if [ -b "$DISK" ]; then
          echo "Disk $DISK found"
          break
        fi
        echo "Waiting for disk $DISK... ($i/30)"
        sleep 2
      done
      
      if [ ! -b "$DISK" ]; then
        echo "ERROR: Disk $DISK not found after 60 seconds"
        exit 1
      fi
      
      # SAFETY CHECK: Detect if disk has ANY partition table or partitions
      # This prevents accidental data loss on pre-formatted disks
      PTTYPE=$(blkid -s PTTYPE -o value "$DISK" 2>/dev/null || echo "")
      HAS_PARTITIONS=$(lsblk -n -o NAME "$DISK" | grep -v "^$(basename $DISK)$" | wc -l)
      
      if [ -n "$PTTYPE" ] || [ "$HAS_PARTITIONS" -gt 0 ]; then
        echo "============================================================"
        echo "DISK HAS EXISTING PARTITION TABLE OR PARTITIONS"
        echo "============================================================"
        echo "Partition table type: ${PTTYPE:-unknown}"
        echo "Partition count: $HAS_PARTITIONS"
        echo ""
        echo "Existing layout:"
        lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT "$DISK"
        echo ""
        echo "To prevent data loss, this script will NOT format the disk."
        echo "If this is a new disk, manually wipe it first:"
        echo "  wipefs -a $DISK"
        echo "============================================================"
        
        # Try to mount existing partition if it exists
        if [ -b "$PARTITION" ]; then
          FSTYPE=$(blkid -s TYPE -o value "$PARTITION" 2>/dev/null || echo "")
          if [ -n "$FSTYPE" ]; then
            echo "Found existing filesystem ($FSTYPE) on $PARTITION"
            mkdir -p "$MOUNT_POINT"
            if ! grep -q "$PARTITION" /etc/fstab; then
              echo "$PARTITION $MOUNT_POINT $FSTYPE defaults,nofail 0 2" >> /etc/fstab
            fi
            if ! mountpoint -q "$MOUNT_POINT"; then
              mount "$MOUNT_POINT" || echo "WARNING: Failed to mount existing partition"
            fi
          fi
        fi
      else
        echo "Disk has no partition table - safe to provision"
        echo "Provisioning new disk..."
        
        # Create GPT partition table
        echo "Creating GPT partition table..."
        parted -s "$DISK" mklabel gpt
        
        # Create single partition using 100% of disk
        echo "Creating partition..."
        parted -s "$DISK" mkpart primary 0% 100%
        
        # Wait for partition to appear
        sleep 2
        partprobe "$DISK" 2>/dev/null || true
        sleep 2
        
        # Format with XFS (good for NFS workloads)
        echo "Formatting with XFS..."
        mkfs.xfs -f "$PARTITION"
        
        echo "Disk provisioned successfully"
        
        # Create mount point
        mkdir -p "$MOUNT_POINT"
        
        # Add to fstab
        echo "$PARTITION $MOUNT_POINT xfs defaults,nofail 0 2" >> /etc/fstab
        
        # Mount the disk
        mount "$MOUNT_POINT"
      fi
      
      # Ensure mount point exists and is mounted
      mkdir -p "$MOUNT_POINT"
      if mountpoint -q "$MOUNT_POINT"; then
        echo "$MOUNT_POINT is mounted"
        
        # Create export directories
        echo "Creating export directories..."
{% for path in nfs_server_export_paths %}
        mkdir -p "{{ path }}"
{% endfor %}
        
        # Set permissions (allow NFS clients full access)
        chmod -R 777 "$MOUNT_POINT"
        
        echo "=== NFS Disk Provisioning Complete ==="
        df -h "$MOUNT_POINT"
      else
        echo "WARNING: $MOUNT_POINT is not mounted - NFS exports may not work"
      fi

package_update: true
package_upgrade: false

packages:
  - nfs-utils
  - xfsprogs
  - parted
  - util-linux
  - blkid

# -----------------------------------------------------------------------------
# Boot Commands (run early, before packages)
# -----------------------------------------------------------------------------
bootcmd:
  - mkdir -p {{ nfs_server_export_root }}

# -----------------------------------------------------------------------------
# Post-Boot Commands
# -----------------------------------------------------------------------------
runcmd:
  # Provision the NFS data disk
  - /usr/local/bin/provision-nfs-disk.sh
  
  # Enable and start NFS server
  - rc-update add nfs
  - rc-update add nfsmount
  - rc-service nfs start
  
  # Re-export all NFS shares
  - exportfs -ra
  
  # Enable QEMU guest agent for Proxmox integration
  - apk add qemu-guest-agent
  - rc-update add qemu-guest-agent
  - rc-service qemu-guest-agent start
  
  # Display export status
  - echo "=== NFS Exports ===" && exportfs -v

# -----------------------------------------------------------------------------
# Final Message
# -----------------------------------------------------------------------------
final_message: |
  Sophon NFS Server is ready!
  System boot took $UPTIME seconds.
  
  NFS Exports:
{% for path in nfs_server_export_paths %}
    {{ nfs_server_ip | default('<IP>') }}:{{ path }}
{% endfor %}
  
  Mount example:
    mount -t nfs {{ nfs_server_ip | default('<IP>') }}:{{ nfs_server_export_root }} /mnt/nfs
