{
  "realm": "{{ keycloak_realm }}",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "clients": [ ... your clients ... ],

{% if keycloak_ldap_enabled %}
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "openldap-federation",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            // Optional: Add explicit mappers here if needed (e.g. custom givenName)
            {
              "name": "givenName-mapper",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": ["firstName"],
                "ldap.attribute": ["givenName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "sync.period": ["-1"]
              }
            }
            // Add more for email, lastName (sn), etc. if defaults are wrong
          ]
        },
        "config": {
          "enabled": ["true"],
          "vendor": ["other"],
          "connectionUrl": ["{{ keycloak_ldap_url }}"],  // e.g. ldaps://ldap.yourdomain:636
          "bindDn": ["{{ keycloak_ldap_bind_dn }}"],
          "bindCredential": ["${LDAP_BIND_PASSWORD}"],
          "usersDn": ["{{ openldap_user_dn | default('ou=users,' ~ openldap_base_dn) }}"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson","posixAccount","shadowAccount"],
          "editMode": ["READ_ONLY"],
          "importUsers": ["true"],               // or "false" for live-only
          "syncRegistrations": ["false"],
          "trustEmail": ["true"],
          "validatePasswordPolicy": ["false"],
          "useKerberosForPasswordAuthentication": ["false"]
          // Add if using groups: "groupsDn": ["ou=groups,{{ openldap_base_dn }}"], etc.
        }
      }
    ]
  }
{% endif %}

  "roles": { ... },
  "defaultRoles": ["user"]
}