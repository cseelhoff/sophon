# Keycloak SSO deployed via Portainer Stacks API
# Realm/clients/LDAP are configured post-deploy via the Admin REST API.

services:
  keycloak:
    image: {{ keycloak_image_name }}:{{ keycloak_image_tag }}
    pull_policy: never
    container_name: keycloak
    restart: unless-stopped
    command:
      - start
      - --hostname={{ keycloak_hostname }}.{{ keycloak_domain }}
      - --proxy-headers=xforwarded
      - --http-enabled=true
    environment:
      - KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
      - KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_admin_password }}
      - KC_DB={{ keycloak_db_type }}
      - KC_DB_URL_HOST={{ keycloak_db_host }}
      - KC_DB_URL_PORT={{ keycloak_db_port }}
      - KC_DB_URL_DATABASE={{ keycloak_db_name }}
      - KC_DB_USERNAME={{ keycloak_db_user }}
      - KC_DB_PASSWORD={{ keycloak_db_password }}
      - KC_HOSTNAME={{ keycloak_hostname }}.{{ keycloak_domain }}
      - KC_HOSTNAME_STRICT=false
      - KC_HTTP_ENABLED=true
    volumes:
      - keycloak_data:/opt/keycloak/data
    networks:
      - proxy
    depends_on:
      keycloak-db:
        condition: service_healthy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.keycloak.entrypoints=websecure"
      - "traefik.http.routers.keycloak.rule=Host(`{{ keycloak_hostname }}.{{ keycloak_domain }}`)"
      - "traefik.http.routers.keycloak.tls=true"
      - "traefik.http.routers.keycloak.tls.certresolver=letsencrypt"
      - "traefik.http.services.keycloak.loadbalancer.server.port=8080"

  keycloak-db:
    image: {{ keycloak_postgres_image }}
    pull_policy: never
    container_name: keycloak-db
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ keycloak_db_name }}
      - POSTGRES_USER={{ keycloak_db_user }}
      - POSTGRES_PASSWORD={{ keycloak_db_password }}
    volumes:
      - keycloak_db_data:/var/lib/postgresql/data
    networks:
      - proxy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ keycloak_db_user }} -d {{ keycloak_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 10s

volumes:
  keycloak_data:
  keycloak_db_data:

networks:
  proxy:
    external: true
