# Keycloak SSO deployed via Portainer Stacks API
# Realm import: startup script writes realm JSON using bash built-ins, then execs kc.sh

services:
  keycloak:
    image: {{ keycloak_image_name }}:{{ keycloak_image_tag }}
    container_name: keycloak
    restart: unless-stopped
    entrypoint: ["/bin/bash", "-c"]
    command:
      - |
        while IFS= read -r _l || [[ -n "$$_l" ]]; do printf '%s\n' "$$_l"; done > /opt/keycloak/data/import/{{ keycloak_realm }}-realm.json <<'REALMEOF'
        {{ lookup('template', 'realm-export.json.j2') | replace('$', '$$') | indent(8) }}
        REALMEOF
        exec /opt/keycloak/bin/kc.sh start \
          --hostname={{ keycloak_hostname }}.{{ keycloak_domain }} \
          --proxy-headers=xforwarded \
          --http-enabled=true \
          --import-realm
    environment:
      - KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
      - KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_admin_password }}
      - KC_DB={{ keycloak_db_type }}
      - KC_HOSTNAME={{ keycloak_hostname }}.{{ keycloak_domain }}
      - KC_HOSTNAME_STRICT=false
      - KC_HTTP_ENABLED=true
      - LDAP_BIND_PASSWORD={{ openldap_keycloak_password }}
    volumes:
      - keycloak_data:/opt/keycloak/data
      - keycloak_import:/opt/keycloak/data/import
    ports:
      - "8080"
    networks:
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.keycloak.entrypoints=websecure"
      - "traefik.http.routers.keycloak.rule=Host(`{{ keycloak_hostname }}.{{ keycloak_domain }}`)"
      - "traefik.http.routers.keycloak.tls=true"
      - "traefik.http.routers.keycloak.tls.certresolver=letsencrypt"
      - "traefik.http.services.keycloak.loadbalancer.server.port=8080"
      - "coredns.dockerdiscovery.cf_tunnel=https://10.0.60.3"

volumes:
  keycloak_data:
  keycloak_import:

networks:
  proxy:
    external: true
