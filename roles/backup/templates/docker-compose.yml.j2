
services:
  backup:
    image: {{ backup_image_name }}:{{ backup_image_tag }}
    container_name: backup
    restart: unless-stopped
    environment:
      - BACKUP_CRON_EXPRESSION={{ backup_schedule }}
      - BACKUP_RETENTION_DAYS={{ backup_retention_days }}
      - BACKUP_FILENAME=backup-%Y-%m-%dT%H-%M-%S.tar.gz
{% if backup_local_enabled %}
      - BACKUP_ARCHIVE={{ backup_local_path }}/backup.tar.gz
{% endif %}
{% if backup_s3_enabled %}
      - AWS_S3_BUCKET_NAME={{ backup_s3_bucket }}
      - AWS_ENDPOINT={{ backup_s3_endpoint | default('s3.amazonaws.com') }}
      - AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
      - AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
{% endif %}
{% if backup_encryption_enabled %}
      - GPG_PASSPHRASE=${GPG_PASSPHRASE}
{% endif %}
{% if backup_notification_enabled %}
      - NOTIFICATION_URLS={{ backup_notification_url }}
{% endif %}
    volumes:
      - /run/podman/podman.sock:/var/run/docker.sock:ro
{% if backup_local_enabled %}
      - {{ backup_local_path }}:{{ backup_local_path }}
{% endif %}
      # Add volumes to backup using labels on containers:
      # docker.backup.stop-during-backup: "true"
      # Volumes are discovered automatically
    networks:
      - backup
    labels:
      - "homepage.group=Infrastructure"
      - "homepage.name=Backup"
      - "homepage.icon=duplicati"
      - "homepage.description=Volume Backup Service"

networks:
  backup:
    driver: bridge
