variant: fcos
version: 1.5.0

passwd:
  users:
    - name: {{ coreos_username }}
      password_hash: {{ coreos_password_hash }}
      groups:
        - sudo
        - wheel

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ coreos_vm_name }}

    - path: /etc/NetworkManager/system-connections/wired.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=Wired connection 1
          type=ethernet
          match-device=type:ethernet

          [ipv4]
          address1={{ coreos_ip }}/{{ coreos_cidr }},{{ coreos_gateway }}
          method=manual

    # Disable systemd-resolved DNS stub listener to free port 53 for CoreDNS
    - path: /etc/systemd/resolved.conf.d/no-stub.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          DNSStubListener=no

    # CoreDNS configuration
    - path: /etc/coredns/Corefile
      mode: 0644
      contents:
        inline: |
          . {
              forward . 8.8.8.8 8.8.4.4
              log
              errors
              cache 30
          }

    # Traefik dynamic configuration
    - path: /etc/traefik/dynamic.yml
      mode: 0644
      contents:
        inline: |
          # Dynamic configuration for Traefik
          # Add routers and services here

    # Script to install QEMU guest agent from NFS share
    - path: /usr/local/bin/setup-qemu-guest-agent.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -e
          
          NFS_MOUNT="{{ coreos_nfs_rpm_mount_point }}"
          
          # Wait for NFS mount to be available
          for i in {1..30}; do
            if mountpoint -q "$NFS_MOUNT"; then
              break
            fi
            echo "Waiting for NFS mount at $NFS_MOUNT..."
            sleep 2
          done
          
          if ! mountpoint -q "$NFS_MOUNT"; then
            echo "ERROR: NFS mount not available at $NFS_MOUNT"
            exit 1
          fi
          
          # Install RPMs (qemu-guest-agent and dependencies)
          rpm-ostree install --apply-live --allow-inactive --assumeyes --cache-only \
            $NFS_MOUNT/{{ coreos_liburing_rpm_filename }} \
            $NFS_MOUNT/{{ coreos_qemu_guest_agent_rpm_filename }}
          
          touch /var/lib/qemu-guest-agent-installed.stamp
          
          # Enable and start qemu-guest-agent
          systemctl enable --now qemu-guest-agent.service

    # Script to load container images from NFS share
    - path: /usr/local/bin/load-container-images.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -e
          
          NFS_MOUNT="{{ coreos_nfs_docker_mount_point }}"
          
          # Wait for NFS mount to be available
          for i in {1..30}; do
            if mountpoint -q "$NFS_MOUNT"; then
              break
            fi
            echo "Waiting for NFS mount at $NFS_MOUNT..."
            sleep 2
          done
          
          if ! mountpoint -q "$NFS_MOUNT"; then
            echo "ERROR: NFS mount not available at $NFS_MOUNT"
            exit 1
          fi
          
          # Load container images from NFS
          for tarfile in $NFS_MOUNT/*.tar; do
            if [ -f "$tarfile" ]; then
              echo "Loading container image: $tarfile"
              /usr/bin/podman load -i "$tarfile"
            fi
          done
          
          touch /var/lib/container-images-loaded.stamp

systemd:
  units:
    # NFS mount for RPM packages (used as Nexus yum-proxy blob store backend)
    - name: mnt-nfs-rpm\x2dpackages.mount
      enabled: true
      contents: |
        [Unit]
        Description=NFS mount for RPM packages
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What={{ nfs_server_ip }}:{{ nfs_rpm_packages_path }}
        Where={{ coreos_nfs_rpm_mount_point }}
        Type=nfs4
        Options={{ coreos_nfs_mount_options }}

        [Install]
        WantedBy=multi-user.target

    # NFS mount for docker images (used as Nexus docker-proxy blob store backend)
    - name: mnt-nfs-docker\x2dimages.mount
      enabled: true
      contents: |
        [Unit]
        Description=NFS mount for container images
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What={{ nfs_server_ip }}:{{ nfs_docker_images_path }}
        Where={{ coreos_nfs_docker_mount_point }}
        Type=nfs4
        Options={{ coreos_nfs_mount_options }}

        [Install]
        WantedBy=multi-user.target

    # Install QEMU guest agent from NFS at first boot
    - name: setup-qemu-guest-agent.service
      enabled: true
      contents: |
        [Unit]
        Description=Install QEMU guest agent from NFS
        After=mnt-nfs-rpm\x2dpackages.mount network-online.target
        Requires=mnt-nfs-rpm\x2dpackages.mount
        Wants=network-online.target
        ConditionPathExists=!/var/lib/qemu-guest-agent-installed.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/setup-qemu-guest-agent.sh

        [Install]
        WantedBy=multi-user.target

    # Load container images from NFS at first boot
    - name: load-container-images.service
      enabled: true
      contents: |
        [Unit]
        Description=Load container images from NFS share
        After=mnt-nfs-docker\x2dimages.mount network-online.target
        Requires=mnt-nfs-docker\x2dimages.mount
        Wants=network-online.target
        ConditionPathExists=!/var/lib/container-images-loaded.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/load-container-images.sh

        [Install]
        WantedBy=multi-user.target

    # Portainer container service
    - name: portainer.service
      enabled: true
      contents: |
        [Unit]
        Description=Portainer Container Management
        # Wait for container images to be loaded from NFS
        After=load-container-images.service network-online.target podman.socket
        Wants=network-online.target
        Requires=podman.socket
        # Only start after images are loaded
        ConditionPathExists=/var/lib/container-images-loaded.stamp

        [Service]
        Type=simple
        Restart=always
        RestartSec=10
        ExecStartPre=-/usr/bin/podman rm -f portainer
        ExecStartPre=-/usr/bin/podman volume create portainer_data
        ExecStart=/usr/bin/podman run --rm --name portainer --privileged \
          -p {{ portainer_port | default(9443) }}:9443 \
          -v /run/podman/podman.sock:/var/run/docker.sock \
          -v portainer_data:/data \
          docker.io/portainer/portainer-ce:{{ portainer_image_tag | default('2.27.1') }}
        ExecStop=/usr/bin/podman stop portainer

        [Install]
        WantedBy=multi-user.target

    # Enable podman socket for Portainer (system-level, not user)
    - name: podman.socket
      enabled: true
