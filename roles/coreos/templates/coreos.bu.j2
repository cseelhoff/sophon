variant: fcos
version: 1.5.0

passwd:
  users:
    - name: {{ coreos_username }}
      password_hash: {{ coreos_password_hash }}
      groups:
        - sudo
        - wheel

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ coreos_vm_name }}

    - path: /etc/NetworkManager/system-connections/wired.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=Wired connection 1
          type=ethernet
          match-device=type:ethernet

          [ipv4]
          address1={{ coreos_ip }}/{{ coreos_cidr }},{{ coreos_gateway }}
          method=manual

    - path: /usr/local/bin/install-qga.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -e
          mkdir -p /mnt/rpms
          # Try common CDROM devices
          mount /dev/sr1 /mnt/rpms 2>/dev/null || mount /dev/sr0 /mnt/rpms
          rpm-ostree install --apply-live --allow-inactive --assumeyes --cache-only /mnt/rpms/*.rpm
          umount /mnt/rpms
          touch /var/lib/qga-installed.stamp
          systemctl enable --now qemu-guest-agent.service

systemd:
  units:
    - name: install-qga-from-iso.service
      enabled: true
      contents: |
        [Unit]
        Description=Install qemu-guest-agent from attached ISO
        After=dev-sr1.device dev-sr0.device local-fs.target
        ConditionPathExists=!/var/lib/qga-installed.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/install-qga.sh

        [Install]
        WantedBy=multi-user.target
