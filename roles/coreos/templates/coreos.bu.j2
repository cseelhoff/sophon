variant: fcos
version: 1.5.0

passwd:
  users:
    - name: {{ coreos_username }}
      password_hash: {{ coreos_password_hash }}
      groups:
        - sudo
        - wheel

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ coreos_vm_name }}

    - path: /etc/NetworkManager/system-connections/wired.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=Wired connection 1
          type=ethernet
          match-device=type:ethernet

          [ipv4]
          address1={{ coreos_ip }}/{{ coreos_cidr }},{{ coreos_gateway }}
          method=manual

    # Disable systemd-resolved DNS stub listener to free port 53 for CoreDNS
    - path: /etc/systemd/resolved.conf.d/no-stub.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          DNSStubListener=no

    # CoreDNS configuration
    - path: /etc/coredns/Corefile
      mode: 0644
      contents:
        inline: |
          . {
              forward . 8.8.8.8 8.8.4.4
              log
              errors
              cache 30
          }

    # Traefik dynamic configuration
    - path: /etc/traefik/dynamic.yml
      mode: 0644
      contents:
        inline: |
          # Dynamic configuration for Traefik
          # Add routers and services here

    # Script to install QGA from ISO and load container images
    - path: /usr/local/bin/setup-from-iso.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -e
          
          ISO_MOUNT=/mnt/iso
          mkdir -p $ISO_MOUNT
          
          # Try common CDROM devices
          mount /dev/sr1 $ISO_MOUNT 2>/dev/null || mount /dev/sr0 $ISO_MOUNT
          
          # Install RPMs (qemu-guest-agent and dependencies)
          rpm-ostree install --apply-live --allow-inactive --assumeyes --cache-only $ISO_MOUNT/*.rpm
          
          # Load container images from ISO (running as root, images go to /var/lib/containers)
          for tarfile in $ISO_MOUNT/*.tar; do
            if [ -f "$tarfile" ]; then
              echo "Loading container image: $tarfile"
              /usr/bin/podman load -i "$tarfile"
            fi
          done
          
          umount $ISO_MOUNT
          touch /var/lib/setup-from-iso.stamp
          
          # Enable and start qemu-guest-agent
          systemctl enable --now qemu-guest-agent.service

systemd:
  units:
    # Install QGA and load container images from ISO at first boot
    - name: setup-from-iso.service
      enabled: true
      contents: |
        [Unit]
        Description=Install QGA and load container images from ISO
        After=dev-sr1.device dev-sr0.device local-fs.target
        ConditionPathExists=!/var/lib/setup-from-iso.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/setup-from-iso.sh

        [Install]
        WantedBy=multi-user.target

    # Portainer container service
    - name: portainer.service
      enabled: true
      contents: |
        [Unit]
        Description=Portainer Container Management
        # On first boot, wait for ISO setup; on subsequent boots, this is a no-op
        After=setup-from-iso.service network-online.target podman.socket
        Wants=network-online.target
        Requires=podman.socket
        # Only start after images are loaded (first boot creates this file)
        ConditionPathExists=/var/lib/setup-from-iso.stamp

        [Service]
        Type=simple
        Restart=always
        RestartSec=10
        ExecStartPre=-/usr/bin/podman rm -f portainer
        ExecStartPre=-/usr/bin/podman volume create portainer_data
        ExecStart=/usr/bin/podman run --rm --name portainer --privileged \
          -p {{ portainer_port | default(9443) }}:9443 \
          -v /run/podman/podman.sock:/var/run/docker.sock \
          -v portainer_data:/data \
          docker.io/portainer/portainer-ce:{{ portainer_image_tag | default('2.27.1') }}
        ExecStop=/usr/bin/podman stop portainer

        [Install]
        WantedBy=multi-user.target

    # Enable podman socket for Portainer (system-level, not user)
    - name: podman.socket
      enabled: true
