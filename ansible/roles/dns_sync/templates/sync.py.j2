#!/usr/bin/env python3
"""
DNS Sync Sidecar for Sophon
Listens to Docker/Podman container events, queries Traefik API for active routers,
and generates a BIND zone file for CoreDNS.
"""

import os
import re
import time
import logging
import requests
import docker

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)

# Configuration from environment
TRAEFIK_API = os.getenv('TRAEFIK_API', 'http://traefik:8080/api/http/routers')
ZONE = os.getenv('ZONE', 'homelab.local').rstrip('.')
ZONE_FILE = os.getenv('ZONE_FILE', '/zones/homelab.local.zone')
CNAME_TARGET = os.getenv('CNAME_TARGET', 'traefik.homelab.local')
TRAEFIK_IP = os.getenv('TRAEFIK_IP', '10.0.1.10')
DEBOUNCE_SECONDS = int(os.getenv('DEBOUNCE_SECONDS', '3'))
SOA_NS = os.getenv('SOA_NS', f'ns1.{ZONE}')
SOA_ADMIN = os.getenv('SOA_ADMIN', f'admin.{ZONE}')
TTL = int(os.getenv('TTL', '60'))

# Regex to extract hostnames from Traefik Host() rules
# Handles: Host(`example.com`), Host(`a.example.com`) || Host(`b.example.com`)
HOST_REGEX = re.compile(r'Host\(`([^`]+)`\)')

# Docker/Podman client
docker_client = docker.from_env()


def get_traefik_hosts():
    """Query Traefik API for enabled routers and extract hosts matching our zone."""
    try:
        response = requests.get(TRAEFIK_API, timeout=10)
        response.raise_for_status()
        routers = response.json()

        hosts = set()
        for router in routers:
            # Only process enabled routers with rules
            if router.get('status') != 'enabled':
                continue
            rule = router.get('rule', '')

            # Extract all Host() matches
            matches = HOST_REGEX.findall(rule)
            for host in matches:
                # Only include hosts in our zone
                if host.endswith(f'.{ZONE}') or host == ZONE:
                    hosts.add(host)

        logger.info(f"Found {len(hosts)} hosts in zone {ZONE}: {sorted(hosts)}")
        return sorted(hosts)

    except requests.exceptions.ConnectionError:
        logger.warning("Cannot connect to Traefik API - is Traefik running?")
        return []
    except Exception as e:
        logger.error(f"Traefik API error: {e}")
        return []


def generate_zone_file(hosts):
    """Generate a standard BIND-format zone file."""
    serial = int(time.time())  # Use Unix timestamp as serial (always incrementing)

    lines = [
        f"; Zone file for {ZONE}",
        f"; Generated by dns-sync sidecar at {time.strftime('%Y-%m-%d %H:%M:%S')}",
        f"; Serial: {serial}",
        "",
        f"$ORIGIN {ZONE}.",
        f"$TTL {TTL}",
        "",
        f"@  IN  SOA  {SOA_NS}. {SOA_ADMIN.replace('@', '.')}. (",
        f"    {serial}   ; Serial",
        "    3600        ; Refresh (1 hour)",
        "    1800        ; Retry (30 min)",
        "    604800      ; Expire (1 week)",
        f"    {TTL} )     ; Minimum TTL",
        "",
        f"; Name servers",
        f"@       IN  NS      {SOA_NS}.",
        "",
        f"; Static records",
        f"@       IN  A       {TRAEFIK_IP}",
        f"traefik IN  A       {TRAEFIK_IP}",
        "",
        f"; Dynamic records from Traefik routers",
    ]

    for host in hosts:
        # Skip if it's the zone apex or traefik (handled statically)
        if host == ZONE or host == f"traefik.{ZONE}":
            continue

        # Extract subdomain portion
        if host.endswith(f'.{ZONE}'):
            subdomain = host[:-len(f'.{ZONE}')]
        else:
            subdomain = host

        lines.append(f"{subdomain:<12} IN  CNAME   {CNAME_TARGET}.")

    lines.append("")  # Trailing newline
    return '\n'.join(lines)


def write_zone_file(content):
    """Atomically write zone file to trigger CoreDNS reload."""
    tmp_file = ZONE_FILE + '.tmp'
    try:
        with open(tmp_file, 'w') as f:
            f.write(content)
        os.rename(tmp_file, ZONE_FILE)  # Atomic on Linux
        logger.info(f"Zone file updated: {ZONE_FILE}")
        return True
    except Exception as e:
        logger.error(f"Failed to write zone file: {e}")
        return False


def get_current_zone_content():
    """Read current zone file content for comparison."""
    try:
        with open(ZONE_FILE, 'r') as f:
            return f.read()
    except FileNotFoundError:
        return None


def normalize_zone_content(content):
    """Normalize zone content for comparison by removing comment lines.

    This allows comparing zone files while ignoring timestamps and serials
    that change on every generation.
    """
    if content is None:
        return None
    lines = content.split('\n')
    # Skip comment lines at the top that change every time
    return '\n'.join(line for line in lines if not line.startswith(';'))


def sync_dns():
    """Perform a DNS sync: query Traefik, generate zone, write if changed."""
    hosts = get_traefik_hosts()
    new_content = generate_zone_file(hosts)

    current_content = get_current_zone_content()

    if normalize_zone_content(current_content) == normalize_zone_content(new_content):
        logger.debug("Zone file unchanged, skipping write")
        return False

    return write_zone_file(new_content)


def main():
    """Main event loop."""
    logger.info(f"DNS Sync Sidecar starting")
    logger.info(f"  Zone: {ZONE}")
    logger.info(f"  Traefik API: {TRAEFIK_API}")
    logger.info(f"  Zone file: {ZONE_FILE}")
    logger.info(f"  CNAME target: {CNAME_TARGET}")

    # Initial sync on startup
    logger.info("Performing initial sync...")
    sync_dns()

    # Listen for Docker/Podman container events
    logger.info("Listening for container events...")

    event_filters = {
        'type': 'container',
        'event': ['start', 'die', 'kill', 'stop', 'destroy']
    }

    for event in docker_client.events(decode=True, filters=event_filters):
        action = event.get('Action', event.get('status', 'unknown'))
        container_name = event.get('Actor', {}).get('Attributes', {}).get('name', 'unknown')

        logger.info(f"Container event: {action} on {container_name}")

        # Debounce: wait for Traefik to update its router list
        time.sleep(DEBOUNCE_SECONDS)

        # Sync DNS
        sync_dns()


if __name__ == '__main__':
    main()
