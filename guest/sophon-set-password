#!/usr/bin/env bash
# First boot of the installed InfraVM: the console login stays locked until the operator chooses the core password.
# Run by sophon-set-password.service on tty1 before the login prompt appears; it does nothing once a password is set.
set -uo pipefail

flag=/var/lib/sophon-core-password-set
[[ ! -e $flag ]] || exit 0

printf '\n== Sophon first boot ==\nChoose the console password for the user "core".\n'
while true; do
    read -r -s -p 'New password for core: ' password || exit 1
    printf '\n'
    read -r -s -p 'Confirm password: ' confirmation || exit 1
    printf '\n'
    if [[ -z $password ]]; then
        echo 'The password must not be empty.'
    elif [[ $password != "$confirmation" ]]; then
        echo 'The passwords do not match.'
    elif printf 'core:%s\n' "$password" | chpasswd; then
        break
    else
        echo 'The password was not accepted; try another.'
    fi
done
unset password confirmation
install -m 0644 /dev/null "$flag"
printf '%s\n\n' 'Password set. Log in as core, then run: sophon-deploy'
