#!/usr/bin/env bash
# First boot of the installed InfraVM: console logins stay locked until the operator chooses the core password.
# Run on tty1 and ttyS0 before login prompts appear; whichever sets the password stops the sibling unit cleanly.
set -uo pipefail

flag=/var/lib/sophon-core-password-set
[[ ! -e $flag ]] || exit 0
trap '[[ -e $flag ]] && exit 0; exit 1' TERM HUP INT

console_name=${1:-tty1}
printf '\n== Sophon first boot ==\nChoose the console password for the user "core".\n'
while true; do
    read -r -s -p 'New password for core: ' password || { [[ -e $flag ]] && exit 0; exit 1; }
    printf '\n'
    read -r -s -p 'Confirm password: ' confirmation || { [[ -e $flag ]] && exit 0; exit 1; }
    printf '\n'
    if [[ -z $password ]]; then
        echo 'The password must not be empty.'
    elif [[ $password != "$confirmation" ]]; then
        echo 'The passwords do not match.'
    elif printf 'core:%s\n' "$password" | chpasswd; then
        break
    else
        echo 'The password was not accepted; try another.'
    fi
done
unset password confirmation
install -m 0644 /dev/null "$flag"
if [[ $console_name == ttyS0 ]]; then
    systemctl stop --no-block sophon-set-password.service 2>/dev/null || true
else
    systemctl stop --no-block sophon-set-password-serial.service 2>/dev/null || true
fi
printf '%s\n\n' 'Password set. Log in as core, then run: sophon-deploy'
