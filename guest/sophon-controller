#!/usr/bin/env bash
# Installed console entry point. The runner has HTTP access, not host privileges.
set -euo pipefail

if [[ $(id -u) != 1000 || $(id -un) != core ]]; then
    echo "Log in as core to run sophon-controller (do not use sudo)." >&2
    exit 1
fi
export HOME=/var/home/core XDG_RUNTIME_DIR=/run/user/1000
unset CONTAINER_HOST CONTAINER_CONNECTION DOCKER_HOST
if [[ ! -f /run/user/1000/sophon-ready ]]; then
    echo "Host setup is not ready. Inspect: journalctl -u sophon-host-bootstrap" >&2
    echo "Retry without reinstalling: sudo systemctl restart sophon-host-bootstrap" >&2
    exit 1
fi

args=(
    --remote=false run --rm --network host --pull never
    -v /var/lib/sophon/project:/workspace:Z --workdir /workspace
    --env SOPHON_DEPLOYMENT_STEP=configure
)
if [[ -t 0 && -t 1 ]]; then
    args+=(-it)
fi
# A secret disk (label SOPHON_CERTS) carries the pre-issued certificate file for air-gapped sites.
# It is copied into the project's imports folder (removed again once it is staged) and then left alone.
certs_device=${SOPHON_CERTS_DEVICE:-/dev/disk/by-label/SOPHON_CERTS}
if [[ -e $certs_device ]]; then
    mount_point=$(mktemp -d)
    if sudo mount -o ro "$certs_device" "$mount_point" 2>/dev/null; then
        if [[ -f $mount_point/acme.json ]]; then
            install -d -m 700 /var/lib/sophon/project/imports
            install -m 600 "$mount_point/acme.json" /var/lib/sophon/project/imports/acme.json
            export SOPHON_ACME_FILE=/workspace/imports/acme.json
            echo "Found the certificate disk; using its acme.json."
        else
            echo "Warning: the certificate disk has no acme.json." >&2
        fi
        sudo umount "$mount_point" || true
    else
        echo "Warning: the certificate disk could not be mounted; no certificate file was loaded." >&2
    fi
    rmdir "$mount_point" 2>/dev/null || true
fi
for name in \
    SOPHON_ACME_FILE SOPHON_INFRAVM_IP SOPHON_VNET_DNS SOPHON_DOMAIN SOPHON_ACME_EMAIL \
    SOPHON_CF_TOKEN SOPHON_CF_TUNNEL_NAME SOPHON_KEYCLOAK_REALM \
    SOPHON_KEYCLOAK_REALM_DISPLAY_NAME SOPHON_KEYCLOAK_ADMIN_PASSWORD \
    SOPHON_KEYCLOAK_DB_PASSWORD SOPHON_KEYCLOAK_PORTAINER_CLIENT_SECRET \
    SOPHON_GITEA_ADMIN_PASSWORD SOPHON_OPENLDAP_ADMIN_PASSWORD \
    SOPHON_OPENLDAP_EXAMPLE_USER_PASSWORD SOPHON_OPENLDAP_EXAMPLE_ADMIN_PASSWORD \
    SOPHON_PORTAINER_LICENSE_KEY SOPHON_PORTAINER_ADMIN_PASSWORD SOPHON_GITEA_DB_PASSWORD
do
    if [[ -v $name ]]; then
        args+=(--env "$name")
    fi
done
exec podman "${args[@]}" sophon:latest python3 src/console.py "$@"
