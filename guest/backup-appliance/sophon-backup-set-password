#!/bin/sh
# First boot of the installed Sophon Backup Server: console login stays locked until admin chooses a password.
set -u

flag=/var/lib/sophon-backup-password-set
[ ! -e "$flag" ] || exit 0

printf '\n== Sophon Backup Server first boot ==\nChoose the console password for the user "admin".\n'
trap 'stty echo 2>/dev/null || true' EXIT INT TERM
while true; do
    printf 'New password for admin: '
    stty -echo 2>/dev/null || true
    IFS= read -r password || exit 1
    stty echo 2>/dev/null || true
    printf '\nConfirm password: '
    stty -echo 2>/dev/null || true
    IFS= read -r confirmation || exit 1
    stty echo 2>/dev/null || true
    printf '\n'
    if [ -z "$password" ]; then
        echo 'The password must not be empty.'
    elif [ "$password" != "$confirmation" ]; then
        echo 'The passwords do not match.'
    elif printf 'admin:%s\n' "$password" | chpasswd; then
        break
    else
        echo 'The password was not accepted; try another.'
    fi
done
unset password confirmation
install -m 0644 /dev/null "$flag"
printf '%s\n\n' 'Password set. Log in as admin, then run: sophon-backup-setup'
