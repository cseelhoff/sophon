#!/usr/bin/env bash
# Installed console entry point. The runner deploys Compose stacks directly over the rootless Podman socket.
set -euo pipefail

if [[ $(id -u) != 1000 || $(id -un) != core ]]; then
    echo "Log in as core to run sophon-deploy (do not use sudo)." >&2
    exit 1
fi
export HOME=/var/home/core XDG_RUNTIME_DIR=/run/user/1000
unset CONTAINER_HOST CONTAINER_CONNECTION DOCKER_HOST

# `--network` asks the network questions again; the first run asks them because nothing is saved yet.
# `--accept-dhcp` or `--network-cidr`/`--gateway` configure static networking non-interactively for serial automation.
site=/var/lib/sophon/project/site.json
redo_network=0
explicit_network=0
network_args=()
forwarded=()
while (( $# )); do
    case $1 in
        --network) redo_network=1; shift ;;
        --accept-dhcp) network_args+=(--accept-dhcp); shift ;;
        --network-cidr|--gateway|--dns)
            (( $# >= 2 )) || { echo "$1 requires a value." >&2; exit 2; }
            explicit_network=1
            network_args+=("$1" "$2")
            shift 2
            ;;
        *) forwarded+=("$1"); shift ;;
    esac
done
set -- "${forwarded[@]}"
network_changed=0
if (( redo_network || explicit_network )) ||
    ! jq -e '(.SOPHON_INFRAVM_IP // "") != "" and (.SOPHON_VNET_DNS // "") != ""' "$site" >/dev/null 2>&1; then
    /usr/local/libexec/sophon-network "${network_args[@]}" "$site"
    network_changed=1
fi
# Host setup (loading the runner image, starting Podman socket) begins at boot; wait for it, and redo it once the
# address is known so the services' DNS points at this machine.
if (( network_changed )) || [[ ! -f /run/user/1000/sophon-ready ]]; then
    echo "Finishing host setup (this can take a few minutes the first time)..."
    sudo systemctl start sophon-host-bootstrap || true
    if (( network_changed )); then sudo systemctl restart sophon-host-bootstrap || true; fi
fi
if [[ ! -f /run/user/1000/sophon-ready ]]; then
    echo "Host setup is not ready. Inspect: journalctl -u sophon-host-bootstrap" >&2
    echo "Retry without reinstalling: sudo systemctl restart sophon-host-bootstrap" >&2
    exit 1
fi

install -d -m 0700 /var/lib/sophon/stacks

args=(
    --remote=false run --rm --network host --pull never
    --security-opt label=disable
    --label sophon.deployment=configure
    -v /run/user/1000/podman/podman.sock:/var/run/docker.sock
    -v /var/lib/sophon/stacks:/var/lib/sophon/stacks
    -v /var/lib/sophon/project:/workspace:Z --workdir /workspace
    --env SOPHON_DEPLOYMENT_STEP=configure
)
if [[ -t 0 && -t 1 ]]; then
    args+=(-it)
fi
# A secret disk (label SOPHON_CERTS) carries the pre-issued certificate file for air-gapped sites.
# It is copied into the project's imports folder (removed again once it is staged) and then left alone.
certs_device=${SOPHON_CERTS_DEVICE:-/dev/disk/by-label/SOPHON_CERTS}
if [[ -e $certs_device ]]; then
    mount_point=$(mktemp -d)
    if sudo mount -o ro "$certs_device" "$mount_point" 2>/dev/null; then
        if [[ -f $mount_point/acme.json ]]; then
            install -d -m 700 /var/lib/sophon/project/imports
            install -m 600 "$mount_point/acme.json" /var/lib/sophon/project/imports/acme.json
            export SOPHON_ACME_FILE=/workspace/imports/acme.json
            echo "Found the certificate disk; using its acme.json."
        else
            echo "Warning: the certificate disk has no acme.json." >&2
        fi
        sudo umount "$mount_point" || true
    else
        echo "Warning: the certificate disk could not be mounted; no certificate file was loaded." >&2
    fi
    rmdir "$mount_point" 2>/dev/null || true
fi
for name in \
    SOPHON_ACME_FILE SOPHON_INFRAVM_IP SOPHON_VNET_DNS SOPHON_DOMAIN SOPHON_ACME_EMAIL \
    SOPHON_CF_TOKEN SOPHON_CF_TUNNEL_ENABLED SOPHON_CF_TUNNEL_NAME \
    SOPHON_KEYCLOAK_REALM \
    SOPHON_KEYCLOAK_REALM_DISPLAY_NAME SOPHON_KEYCLOAK_ADMIN_PASSWORD \
    SOPHON_KEYCLOAK_DB_PASSWORD SOPHON_KEYCLOAK_ARCANE_CLIENT_SECRET \
    SOPHON_GITEA_ADMIN_PASSWORD SOPHON_OPENLDAP_ADMIN_PASSWORD \
    SOPHON_OPENLDAP_EXAMPLE_USER_PASSWORD SOPHON_OPENLDAP_EXAMPLE_ADMIN_PASSWORD \
    SOPHON_ARCANE_ADMIN_PASSWORD SOPHON_GITEA_DB_PASSWORD \
    SOPHON_KOPIA_PASSWORD SOPHON_KOPIA_SERVER_USERNAME SOPHON_KOPIA_SERVER_PASSWORD \
    SOPHON_KOPIA_SFTP_HOST SOPHON_KOPIA_SFTP_PORT SOPHON_KOPIA_SFTP_USERNAME SOPHON_KOPIA_SFTP_PATH \
    SOPHON_KOPIA_SFTP_PRIVATE_KEY_B64 SOPHON_KOPIA_SFTP_KNOWN_HOSTS_B64 \
    SOPHON_KOPIA_CREATE_REPOSITORY \
    SOPHON_KOPIA_CLIENT_USERNAME SOPHON_KOPIA_CLIENT_HOSTNAME SOPHON_KOPIA_EXTRA_VOLUMES \
    SOPHON_KOPIA_BACKUPS_ENABLED SOPHON_KOPIA_SNAPSHOT_INTERVAL \
    SOPHON_KOPIA_COARSE_ENABLED SOPHON_KOPIA_COARSE_VOLUMES_DIR SOPHON_KOPIA_COARSE_WORK_DIR
do
    if [[ -v $name ]]; then
        args+=(--env "$name")
    fi
done
if [[ -v SOPHON_PREPARE_RESTORE ]]; then
    args+=(--env SOPHON_PREPARE_RESTORE)
fi
exec podman "${args[@]}" sophon:latest python3 src/console.py "$@"
