#!/usr/bin/env bash
# Promote a standby-restored InfraVM into active production (enable scheduled Kopia backups + optional Cloudflare tunnel).
set -euo pipefail

if [[ $(id -u) != 1000 || $(id -un) != core ]]; then
    echo "Log in as core to run sophon-activate (do not use sudo)." >&2
    exit 1
fi
export HOME=/var/home/core XDG_RUNTIME_DIR=/run/user/1000
unset CONTAINER_HOST CONTAINER_CONNECTION DOCKER_HOST

if ! podman --remote=false container exists kopia; then
    echo "Kopia container is not deployed yet; run sophon-deploy first." >&2
    exit 1
fi

kopia_env_json=$(podman --remote=false inspect --format '{{json .Config.Env}}' kopia)

# Read SOPHON_CF_TOKEN from an attached SOPHON_CERTS seed disk if present and not already exported.
certs_device=${SOPHON_CERTS_DEVICE:-/dev/disk/by-label/SOPHON_CERTS}
if [[ -z ${SOPHON_CF_TOKEN:-} && -e $certs_device ]]; then
    mnt=$(mktemp -d)
    if sudo mount -o ro "$certs_device" "$mnt" 2>/dev/null; then
        if [[ -f $mnt/sophon-seed.json ]]; then
            tok=$(jq -r '.env.SOPHON_CF_TOKEN // empty' "$mnt/sophon-seed.json" 2>/dev/null || true)
            if [[ -n $tok ]]; then
                export SOPHON_CF_TOKEN=$tok
            fi
        fi
        sudo umount "$mnt" || true
    fi
    rmdir "$mnt" 2>/dev/null || true
fi

args=(
    --remote=false run --rm --network host --pull never
    --security-opt label=disable
    --label sophon.deployment=activate
    -v /run/user/1000/podman/podman.sock:/var/run/docker.sock
    -v /var/lib/sophon/stacks:/var/lib/sophon/stacks
    -v /var/lib/sophon/project:/workspace:Z --workdir /workspace
    --env SOPHON_DEPLOYMENT_STEP=configure
)
if [[ -t 0 && -t 1 ]]; then
    args+=(-it)
fi
for name in SOPHON_DOMAIN SOPHON_INFRAVM_IP SOPHON_VNET_DNS SOPHON_CF_TOKEN \
    SOPHON_CF_TUNNEL_ENABLED SOPHON_CF_TUNNEL_NAME SOPHON_ACME_EMAIL \
    SOPHON_KOPIA_PASSWORD SOPHON_KOPIA_SNAPSHOT_INTERVAL SOPHON_KOPIA_COARSE_ENABLED; do
    if [[ -v $name ]]; then
        args+=(--env "$name")
    fi
done

export SOPHON_ACTIVATE_KOPIA_ENV_JSON="$kopia_env_json"
args+=(--env SOPHON_ACTIVATE_KOPIA_ENV_JSON)

podman "${args[@]}" sophon:latest python3 src/activate.py "$@"
if [[ -x /usr/local/libexec/sophon-update-issue ]]; then
    domain=$(jq -r '.domain // empty' /var/lib/sophon/project/deploy-result.json 2>/dev/null || true)
    ip=$(jq -r '.infravm_ip // empty' /var/lib/sophon/project/deploy-result.json 2>/dev/null || true)
    sudo /usr/local/libexec/sophon-update-issue active "${domain:-sophon}" "${ip:-}" "" 2>/dev/null || true
fi
