#!/usr/bin/env bash
# Syncs CoreOS host registry auth/split-horizon resolution for Nexus (`registry.<domain>`)
# and reconciles pure GitOps workload stacks from local Gitea (`ops/workloads` by default).
set -euo pipefail

if [[ $(id -u) != 1000 || $(id -un) != core ]]; then
    echo "Run sophon-reconcile-gitops as core (do not use sudo)." >&2
    exit 1
fi
sophon_home=${SOPHON_HOME_OVERRIDE:-/var/home/sophon}
sophon_xdg=${SOPHON_XDG_RUNTIME_OVERRIDE:-/run/user/1001}
unset CONTAINER_HOST CONTAINER_CONNECTION DOCKER_HOST

as_sophon() {
    if [[ -n ${SOPHON_HOME_OVERRIDE:-} || -n ${SOPHON_XDG_RUNTIME_OVERRIDE:-} ]] || [[ $(id -u) == 1001 ]]; then
        env HOME="$sophon_home" XDG_RUNTIME_DIR="$sophon_xdg" DBUS_SESSION_BUS_ADDRESS="unix:path=${sophon_xdg}/bus" "$@"
    else
        sudo -u sophon -- env HOME="$sophon_home" XDG_RUNTIME_DIR="$sophon_xdg" DBUS_SESSION_BUS_ADDRESS="unix:path=${sophon_xdg}/bus" "$@"
    fi
}

sync_auth_only=0
standby_mode=0
restore_data=0
gitops_repo=${SOPHON_GITOPS_REPO:-ops/workloads}

while (( $# )); do
    case $1 in
        --sync-auth-only) sync_auth_only=1; shift ;;
        --standby) standby_mode=1; shift ;;
        --restore-data) restore_data=1; shift ;;
        --repo)
            (( $# >= 2 )) || { echo "--repo requires <owner/name>." >&2; exit 2; }
            gitops_repo=$2; shift 2 ;;
        -h|--help)
            cat <<'EOF'
Usage: sophon-reconcile-gitops [--sync-auth-only] [--standby] [--restore-data] [--repo <owner/name>]

Options:
  --sync-auth-only  Configure local host /etc/hosts, TLS trust, Podman registries.conf.d mirror, and auth.json for registry.<domain>, then exit.
  --standby         Skip stacks marked with `x-sophon-standby: skip` or label `sophon.standby.skip=true` (e.g. CI runners).
  --restore-data    Restore matching Kopia backup groups (`sophon-restore --group <stack> --snapshot latest --yes`).
  --repo <org/repo> Local Gitea GitOps repository path (default: ops/workloads).
EOF
            exit 0 ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2 ;;
    esac
done

[[ $gitops_repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    echo "Invalid --repo '$gitops_repo'; expected <owner>/<name>." >&2
    exit 2
}

project=${SOPHON_PROJECT_DIR:-/var/lib/sophon/project}
stacks_dir=${SOPHON_STACKS_DIR:-/var/lib/sophon/stacks}
hosts_file=${SOPHON_HOSTS_FILE:-/etc/hosts}
containers_etc=${SOPHON_CONTAINERS_ETC:-/etc/containers}
domain=$(as_sophon jq -r '.domain // empty' "$project/deploy-result.json" 2>/dev/null || true)
if [[ -z $domain ]] && as_sophon test -f "$stacks_dir/nexus/compose.yaml"; then
    domain=$(as_sophon sed -n 's/.*Host(`nexus\.\([^`]*\)`).*/\1/p' "$stacks_dir/nexus/compose.yaml" | head -n1 || true)
fi
domain=${domain%.}
domain=${domain,,}
ip=$(as_sophon jq -r '.SOPHON_INFRAVM_IP // empty' "$project/site.json" 2>/dev/null || true)
if [[ -z $ip ]]; then
    ip=$(as_sophon jq -r '.infravm_ip // empty' "$project/deploy-result.json" 2>/dev/null || true)
fi

if [[ -z $domain || -z $ip ]]; then
    exit 0
fi

# 1. Point CoreOS host resolution for Sophon endpoints at this VM's local Traefik listener
#    so host-level `podman pull registry.<domain>/...` stays 100% local in air-gapped and standby_restore modes.
hosts_tmp=$(mktemp)
awk '
    /^# BEGIN SOPHON HOST SERVICES$/ { skip=1; next }
    /^# END SOPHON HOST SERVICES$/ { skip=0; next }
    !skip { print }
' "$hosts_file" > "$hosts_tmp"
cat >> "$hosts_tmp" <<EOF
# BEGIN SOPHON HOST SERVICES
${ip} ${domain} status.${domain} nexus.${domain} registry.${domain} registry-push.${domain} git.${domain} auth.${domain} arcane.${domain} kopia.${domain}
# END SOPHON HOST SERVICES
EOF
chmod 0644 "$hosts_tmp"
sudo cp "$hosts_tmp" "$hosts_file"
rm -f "$hosts_tmp"

# 2. Sync Nexus TLS chain (if dumped by traefik-certs-dumper), Podman mirror registries.conf,
#    and `sophon-pull` credentials into Podman/Docker auth.
if as_sophon podman --remote=false container exists nexus; then
    podman_cfg_changed=0
    cert_pem=$(as_sophon podman --remote=false exec nexus sh -c "cat '/run/secrets/ldap/certs/${domain}.crt' 2>/dev/null || true" || true)
    if [[ $cert_pem == *"BEGIN CERTIFICATE"* ]]; then
        cert_expected=$(printf '%s\n' "$cert_pem")
        for reg_host in "registry.${domain}" "registry-push.${domain}"; do
            cert_target="${containers_etc}/certs.d/${reg_host}/ca.crt"
            cert_current=$(cat "$cert_target" 2>/dev/null || true)
            if [[ $cert_current != "$cert_expected" ]]; then
                sudo install -d -m 0755 "${containers_etc}/certs.d/${reg_host}"
                printf '%s\n' "$cert_pem" | sudo tee "$cert_target" >/dev/null
                sudo chmod 0644 "$cert_target"
                podman_cfg_changed=1
            fi
        done
    fi

    mirror_target="${containers_etc}/registries.conf.d/sophon-nexus.conf"
    mirror_tmp=$(mktemp)
    cat > "$mirror_tmp" <<EOF
# Managed by Sophon (sophon-reconcile-gitops) — routes upstream OCI pulls through local Nexus cache
# while preserving automatic fallback to upstream registries when Nexus is temporarily unavailable.
[[registry]]
prefix = "docker.io"
location = "docker.io"
[[registry.mirror]]
location = "registry.${domain}"

[[registry]]
prefix = "ghcr.io"
location = "ghcr.io"
[[registry.mirror]]
location = "registry.${domain}"

[[registry]]
prefix = "quay.io"
location = "quay.io"
[[registry.mirror]]
location = "registry.${domain}"
EOF
    if ! cmp -s "$mirror_tmp" "$mirror_target" 2>/dev/null; then
        sudo install -d -m 0755 "${containers_etc}/registries.conf.d"
        chmod 0644 "$mirror_tmp"
        sudo cp "$mirror_tmp" "$mirror_target"
        podman_cfg_changed=1
    fi
    rm -f "$mirror_tmp"

    # Podman's daemonless API service (`podman.service` behind `podman.socket`) caches registries.conf
    # in process memory; restarting only `podman.service` leaves running containers untouched via conmon
    # while making Arcane (`podman.sock`) pick up the updated mirror/certs immediately.
    if (( podman_cfg_changed == 1 )); then
        as_sophon systemctl --user try-restart podman.service 2>/dev/null || true
    fi

    pull_pw=$(as_sophon podman --remote=false exec nexus sh -c 'cat /nexus-data/etc/sophon-pull.password 2>/dev/null || true' || true)
    if [[ -z $pull_pw ]] && as_sophon test -f "$project/credentials/nexus/pull_password"; then
        pull_pw=$(as_sophon tr -d '\r\n' < <(as_sophon cat "$project/credentials/nexus/pull_password"))
    fi
    if [[ -n $pull_pw ]]; then
        token=$(printf 'sophon-pull:%s' "$pull_pw" | base64 -w0)
        for auth_file in "$sophon_home/.config/containers/auth.json" "$sophon_home/.docker/config.json"; do
            as_sophon install -d -m 0700 "$(dirname "$auth_file")"
            existing='{}'
            if as_sophon test -s "$auth_file"; then
                existing=$(as_sophon cat "$auth_file" 2>/dev/null || printf '{}')
            fi
            jq --arg host "registry.${domain}" --arg auth "$token" \
                '.auths = ((.auths // {}) + {($host): {"auth": $auth}})' <<< "$existing" \
                | as_sophon sh -c 'umask 077; cat > "$1.tmp" && mv "$1.tmp" "$1"' _ "$auth_file"
        done
    fi
fi

# Ensure the sophon-status PKCE OIDC client exists in Keycloak even after restoring an older snapshot.
if as_sophon podman --remote=false container exists keycloak; then
    kc_env=$(as_sophon podman --remote=false inspect --format '{{range .Config.Env}}{{println .}}{{end}}' keycloak 2>/dev/null || true)
    kc_user=$(awk -F= '$1=="KC_BOOTSTRAP_ADMIN_USERNAME"{sub(/^[^=]*=/,""); print; exit}' <<< "$kc_env")
    kc_pass=$(awk -F= '$1=="KC_BOOTSTRAP_ADMIN_PASSWORD"{sub(/^[^=]*=/,""); print; exit}' <<< "$kc_env")
    kc_realm="sophon"
    if as_sophon test -f /var/lib/sophon/stacks/status/.env; then
        r_val=$(as_sophon sed -n 's/^SOPHON_STATUS_OIDC_REALM="\(.*\)"$/\1/p' /var/lib/sophon/stacks/status/.env | head -n1 || true)
        [[ -z $r_val ]] || kc_realm=$r_val
    fi
    if [[ -n $kc_user && -n $kc_pass ]]; then
        kc_tok=$(curl -ksS --max-time 10 --resolve "auth.${domain}:443:${ip}" \
            -X POST "https://auth.${domain}/realms/master/protocol/openid-connect/token" \
            --data-urlencode "grant_type=password" \
            --data-urlencode "client_id=admin-cli" \
            --data-urlencode "username=${kc_user}" \
            --data-urlencode "password=${kc_pass}" 2>/dev/null | jq -r '.access_token // empty' || true)
        if [[ -n $kc_tok ]]; then
            existing_id=$(curl -ksS --max-time 10 --resolve "auth.${domain}:443:${ip}" \
                -H "Authorization: Bearer ${kc_tok}" \
                "https://auth.${domain}/admin/realms/${kc_realm}/clients?clientId=sophon-status" 2>/dev/null \
                | jq -r '.[0].id // empty' || true)
            if [[ -z $existing_id ]]; then
                payload=$(jq -n --arg d "$domain" '{
                    clientId: "sophon-status",
                    name: "Sophon Appliance Status",
                    enabled: true,
                    protocol: "openid-connect",
                    publicClient: true,
                    standardFlowEnabled: true,
                    implicitFlowEnabled: false,
                    directAccessGrantsEnabled: false,
                    serviceAccountsEnabled: false,
                    frontchannelLogout: true,
                    fullScopeAllowed: true,
                    redirectUris: [("https://" + $d + "/oauth2/callback"), ("https://status." + $d + "/oauth2/callback")],
                    webOrigins: [("https://" + $d), ("https://status." + $d)],
                    attributes: {
                        "pkce.code.challenge.method": "S256",
                        "post.logout.redirect.uris": ("https://" + $d + "/*##https://status." + $d + "/*")
                    }
                }')
                curl -ksS --max-time 10 --resolve "auth.${domain}:443:${ip}" \
                    -X POST "https://auth.${domain}/admin/realms/${kc_realm}/clients" \
                    -H "Authorization: Bearer ${kc_tok}" -H "Content-Type: application/json" \
                    -d "$payload" >/dev/null 2>&1 || true
                existing_id=$(curl -ksS --max-time 10 --resolve "auth.${domain}:443:${ip}" \
                    -H "Authorization: Bearer ${kc_tok}" \
                    "https://auth.${domain}/admin/realms/${kc_realm}/clients?clientId=sophon-status" 2>/dev/null \
                    | jq -r '.[0].id // empty' || true)
            fi
            if [[ -n $existing_id ]]; then
                grp_scope=$(curl -ksS --max-time 10 --resolve "auth.${domain}:443:${ip}" \
                    -H "Authorization: Bearer ${kc_tok}" \
                    "https://auth.${domain}/admin/realms/${kc_realm}/client-scopes" 2>/dev/null \
                    | jq -r '.[] | select(.name=="groups") | .id // empty' | head -n1 || true)
                if [[ -n $grp_scope ]]; then
                    curl -ksS --max-time 10 --resolve "auth.${domain}:443:${ip}" \
                        -X PUT "https://auth.${domain}/admin/realms/${kc_realm}/clients/${existing_id}/default-client-scopes/${grp_scope}" \
                        -H "Authorization: Bearer ${kc_tok}" >/dev/null 2>&1 || true
                fi
            fi
        fi
    fi
fi

if (( sync_auth_only )); then
    exit 0
fi

# 3. Export pure GitOps repository directly from local Gitea's `/data` bare repo if present.
if ! as_sophon podman --remote=false container exists gitea; then
    echo "Gitea container is not deployed; skipping GitOps workload reconciliation."
    exit 0
fi

bare_repo="/data/git/repositories/${gitops_repo,,}.git"
resolved_ref=$(as_sophon podman --remote=false exec -u 1000:1000 gitea sh -c "
    test -d '$bare_repo' || exit 1
    for ref in HEAD refs/heads/main refs/heads/master; do
        if git --git-dir='$bare_repo' rev-parse --verify \"\$ref\" >/dev/null 2>&1; then
            printf '%s' \"\$ref\"
            exit 0
        fi
    done
    exit 1
" 2>/dev/null || true)
if [[ -z $resolved_ref ]]; then
    echo "No '${gitops_repo}' GitOps repository with commits found in local Gitea; skipping Stage-2 workload reconciliation."
    exit 0
fi

work_dir=$(mktemp -d /tmp/sophon-gitops-XXXXXX)
chmod 0755 "$work_dir"
cleanup() { rm -rf "$work_dir"; }
trap cleanup EXIT

as_sophon podman --remote=false exec -u 1000:1000 gitea git --git-dir="$bare_repo" archive --format=tar "$resolved_ref" | tar -xf - -C "$work_dir"
chmod -R a+rX "$work_dir"

declare -A core_stacks=(
    [coredns]=1 [traefik]=1 [cloudflared]=1 [openldap]=1
    [keycloak]=1 [gitea]=1 [nexus]=1 [arcane]=1 [kopia]=1
)

snapshot_groups=""
if (( restore_data )) && as_sophon podman --remote=false container exists kopia; then
    snapshot_groups=$(/usr/local/bin/sophon-restore inspect --snapshot latest 2>/dev/null | jq -r '.groups[]?.name // empty' || true)
fi

candidate_dirs=()
for dir in "$work_dir"/* "$work_dir"/stacks/*; do
    [[ -d $dir && ! -L $dir ]] || continue
    [[ $(basename "$dir") == "stacks" && $dir == "$work_dir/stacks" ]] && continue
    candidate_dirs+=("$dir")
done

reconciled=()
for dir in "${candidate_dirs[@]}"; do
    [[ -d $dir && ! -L $dir ]] || continue
    stack=$(basename "$dir")
    [[ $stack =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || continue
    if [[ -n ${core_stacks[$stack]:-} ]]; then
        echo "Refusing to overwrite Sophon Core stack '$stack' from GitOps repository." >&2
        continue
    fi
    compose_file=""
    if [[ -f $dir/compose.yaml && ! -L $dir/compose.yaml ]]; then
        compose_file="$dir/compose.yaml"
    elif [[ -f $dir/docker-compose.yml && ! -L $dir/docker-compose.yml ]]; then
        compose_file="$dir/docker-compose.yml"
    else
        continue
    fi

    if (( standby_mode )) && grep -Eq '(^|[[:space:]"'\''])(x-sophon-standby:[[:space:]]*skip|sophon\.standby\.skip=true)' "$compose_file"; then
        echo "Skipping standby-excluded GitOps stack: $stack"
        continue
    fi

    dest="${stacks_dir}/${stack}"
    as_sophon sh -c 'rm -rf "$1.staging" && install -d -m 0700 "$1.staging" && cp -a "$2"/. "$1.staging"/ && rm -rf "$1" && mv "$1.staging" "$1"' _ "$dest" "$dir"

    compose_basename=$(basename "$compose_file")
    echo "Deploying GitOps workload stack: $stack"
    as_sophon podman --remote=false run --rm --network host --pull never \
        --security-opt label=disable \
        -v "${sophon_xdg}/podman/podman.sock:/var/run/docker.sock" \
        -v "${stacks_dir}:${stacks_dir}" \
        sophon:latest docker compose \
        --project-name "$stack" \
        --project-directory "$dest" \
        -f "$dest/$compose_basename" \
        up -d

    if (( restore_data )) && grep -Fqx "$stack" <<< "$snapshot_groups"; then
        echo "Restoring Kopia application state for GitOps stack: $stack"
        /usr/local/bin/sophon-restore --group "$stack" --snapshot latest --yes
    fi
    reconciled+=("$stack")
done

if (( ${#reconciled[@]} > 0 )); then
    printf 'Reconciled GitOps stacks: %s\n' "${reconciled[*]}"
else
    echo "No deployable workload stack directories found in ${gitops_repo}."
fi
