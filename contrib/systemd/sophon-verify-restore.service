[Unit]
Description=Sophon weekly automated disaster-recovery restore drill (Proxmox serial0)
Documentation=https://github.com/cseelhoff/sophon/blob/main/docs/operator-guide.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Edit WorkingDirectory to match where sophon is checked out on your workstation.
WorkingDirectory=%h/sophon
# Optional dedicated secrets/settings file (chmod 600) outside .env so production .env stays minimal:
EnvironmentFile=-%h/.config/sophon/verify-restore.env
ExecStart=/usr/bin/env bash ./sophon-provision.sh verify-restore
TimeoutStartSec=2h
Nice=10
